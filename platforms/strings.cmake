# Keep the source literals intact so C++ decodes escapes exactly once.

# Parse one Apple-style .strings file. Exposes ${prefix}_keys and
# ${prefix}_value_<key> in the caller's scope.
function(kobalt_parse_strings input prefix)
    file(STRINGS "${input}" lines ENCODING UTF-8)
    set(keys)
    set(line_number 0)
    foreach(line IN LISTS lines)
        math(EXPR line_number "${line_number} + 1")
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^/\\*.*\\*/$")
            continue()
        endif()
        if(NOT line MATCHES [=[^"([a-z0-9_.]+)"[ \t]*=[ \t]*("([^"\\]|\\["\\nrt])*");$]=])
            message(FATAL_ERROR "Invalid UI string at ${input}:${line_number}: ${line}")
        endif()
        set(key "${CMAKE_MATCH_1}")
        set(value "${CMAKE_MATCH_2}")
        if(key IN_LIST keys)
            message(FATAL_ERROR "Duplicate UI string key at ${input}:${line_number}: ${key}")
        endif()
        list(APPEND keys "${key}")
        set("${prefix}_value_${key}" "${value}" PARENT_SCOPE)
    endforeach()
    if(NOT keys)
        message(FATAL_ERROR "UI strings are empty: ${input}")
    endif()
    set("${prefix}_keys" "${keys}" PARENT_SCOPE)
endfunction()

# Every locale must expose the same keys with the same ordered %n slots, so a
# missing translation degrades to the build instead of an English leak.
function(kobalt_check_string_parity primary secondary)
    kobalt_parse_strings("${primary}" primary)
    kobalt_parse_strings("${secondary}" secondary)
    set(primary_keys "${primary_keys}")
    set(secondary_keys "${secondary_keys}")
    list(SORT primary_keys)
    list(SORT secondary_keys)
    if(NOT primary_keys STREQUAL secondary_keys)
        set(missing "${primary_keys}")
        list(REMOVE_ITEM missing ${secondary_keys})
        set(extra "${secondary_keys}")
        list(REMOVE_ITEM extra ${primary_keys})
        message(FATAL_ERROR
            "UI string key mismatch between ${primary} and ${secondary}. "
            "Missing in secondary: ${missing}; extra in secondary: ${extra}")
    endif()
    foreach(key IN LISTS primary_keys)
        set(primary_value "${primary_value_${key}}")
        set(secondary_value "${secondary_value_${key}}")
        string(REGEX MATCHALL "%[1-9][0-9]?" primary_slots "${primary_value}")
        string(REGEX MATCHALL "%[1-9][0-9]?" secondary_slots "${secondary_value}")
        list(SORT primary_slots)
        list(SORT secondary_slots)
        if(NOT primary_slots STREQUAL secondary_slots)
            message(FATAL_ERROR
                "UI string argument mismatch for ${key}: ${primary} has [${primary_slots}], "
                "${secondary} has [${secondary_slots}]")
        endif()
    endforeach()
endfunction()

function(kobalt_generate_strings input output)
    get_filename_component(input_name "${input}" NAME)
    kobalt_parse_strings("${input}" parsed)
    set(keys "${parsed_keys}")
    # Code references are validated against the English reference file only.
    foreach(source IN LISTS ARGN)
        file(READ "${source}" code)
        string(REGEX MATCHALL [=[strings::(get|key)[ \t\r\n]*\([ \t\r\n]*"[a-z0-9_.]+"]=] references "${code}")
        foreach(reference IN LISTS references)
            string(REGEX REPLACE [=[.*"([a-z0-9_.]+)"$]=] "\\1" key "${reference}")
            if(NOT key IN_LIST keys)
                message(FATAL_ERROR "Missing UI string ${key} used by ${source}")
            endif()
        endforeach()
    endforeach()
    list(SORT keys)
    set(content "// Generated from assets/${input_name}. Do not edit.\n")
    foreach(key IN LISTS keys)
        string(APPEND content "    {\"${key}\", ${parsed_value_${key}}},\n")
    endforeach()
    if(EXISTS "${output}")
        file(READ "${output}" previous)
        if(previous STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${output}" "${content}")
endfunction()
