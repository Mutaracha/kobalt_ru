@@ -0,0 +1,26 @@
+#pragma once
+#include "support/strings.h"
+#include <QString>
+#include <QStringList>
+
+namespace kobalt {
+inline bool russianFontRoles() { return strings::locale() == strings::Locale::Russian; }
+inline const char *localeDefaultFontFace() { return russianFontRoles() ? "NV Literata" : "Libron"; }
+inline const char *localePublisherSansFontFace() { return russianFontRoles() ? "NV Publica" : "NV Legible Next"; }
+inline const char *localeBookishFontFace() { return russianFontRoles() ? "KF Sable" : "NV Ancizar Serif"; }
+inline QString localeReadingFamily(QString family)
+{
+    if (!russianFontRoles()) return family;
+    if (family == "Libron" || family == "KF Libron" || family == "Literata" || family == "KF Literata") return "NV Literata";
+    if (family == "NV Legible Next" || family == "KF Legible Next" || family == "Noto Serif") return "NV Publica";
+    if (family == "NV Ancizar Serif" || family == "KF Ancizar Serif" || family == "Lora" || family == "NV Sable") return "KF Sable";
+    return family;
+}
+inline bool hiddenRussianReadingFamily(QString family)
+{
+    if (!russianFontRoles()) return false;
+    if (localeReadingFamily(family) != family) return true;
+    if (family.startsWith("NV ") || family.startsWith("KF ")) family = family.mid(3);
+    return QStringList{"Adelph", "Aleo", "Andada", "Basker", "Castoro", "Yrsa", "Kalam", "Instrument Serif"}.contains(family);
+}
+} // namespace kobalt
