+static int inkPixels(const QImage &image)
+{
+    int count = 0;
+    for (int y = 0; y < image.height(); ++y)
+        for (int x = 0; x < image.width(); ++x)
+            count += qGray(image.pixel(x, y)) < 200;
+    return count;
+}
+
+// Checks RU label rasters, sleep fitting, percent contracts, statistics and EN isolation.
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    const auto language = argc > 1 && QByteArray(argv[1]) == "en"
+            ? strings::Locale::English : strings::Locale::Russian;
+    strings::setLocale(language);
+    {
+        const QJsonObject mode{ { menustatus::preferenceKey, "book_page" } };
+        headerfooter::Values values;
+        values.page = 123456;
+        values.pages = 987654;
+        for (int scenario = 0; scenario < 5; ++scenario) {
+            values.pagesEstimated = scenario == 1;
+            values.percentTenths = scenario == 2 ? 120 : -1;
+            values.useScreens = scenario == 3;
+            values.printedPage = scenario == 4 ? QStringLiteral("xviii") : QString();
+            require(menustatus::text(mode, values)
+                            == headerfooter::content(headerfooter::Field::BookPage, values, false).text,
+                    "Menu must use BookPage formatting, including pending/estimated/publisher labels");
+            require(menustatus::text({}, values).isEmpty(), "Page formatter leaked into session mode");
+        }
+    }
+    require(test::readerAssets().available(), "Control assets unavailable");
+    require(ui::initializeInterfaceFonts(test::readerAssets()), "Control fonts unavailable");
+    require(ui::brandFont(40).family() == (language == strings::Locale::Russian
+                    ? "Noto Serif Display Condensed" : "Instrument Serif"), "Wrong locale serif family");
+    require(ui::wordmarkFont(40).family() == QStringLiteral("Instrument Serif")
+                    && !ui::wordmarkFont(40).italic(),
+            "Latin wordmark must stay Instrument Serif in either locale");
+    require(reader::themePreset("classic").mainFace.isEmpty(),
+            "Handwriting replacement changed the ordinary UI default");
+    require(reader::themePreset("playful").mainFace == (language == strings::Locale::Russian
+                    ? "Shantell Sans" : "Kalam"), "Wrong locale handwriting preset");
+    ui::setInterfaceFontFamily(reader::themePreset("playful").mainFace);
+    require(ui::interfaceFont(32).italic() == (language == strings::Locale::Russian),
+            "RU Shantell must be italic, English Kalam remains upright");
+    require(!ui::interfaceInkBounds(QString::fromUtf8("Русский текст Ёж"), ui::interfaceFont(32)).isEmpty(),
+            "RU handwriting failed to measure Cyrillic");
+    QWidget handwritingRoot;
+    QLabel handwritingLabel(QString::fromUtf8("Пример"), &handwritingRoot);
+    ui::readerStyle(&handwritingRoot, ui::styles::reader());
+    handwritingRoot.ensurePolished();
+    handwritingLabel.ensurePolished();
+    require(handwritingLabel.font().italic() == (language == strings::Locale::Russian),
+            "polished handwriting QLabel lost the locale italic style");
+    ui::setInterfaceFontFamily({});
+    require(!ui::interfaceFont(32).italic(), "handwriting italic leaked into classic UI");
+    require(reader::customInterfaceStyle({{"ui_font_face", "Caveat"}}).mainFace
+                    == (language == strings::Locale::Russian ? "Shantell Sans" : "Caveat"),
+            "legacy handwriting override migration changed the wrong locale");
+    require(ui::localeStatisticPixels(100) == (language == strings::Locale::Russian ? 80 : 100),
+            "Statistics scale leaked across locales");
+
+    const bool ru = language == strings::Locale::Russian;
+    require(QString::fromLatin1(localeDefaultFontFace()) == (ru ? "NV Literata" : "Libron")
+                    && QString::fromLatin1(localePublisherSansFontFace()) == (ru ? "NV Publica" : "NV Legible Next")
+                    && QString::fromLatin1(localeBookishFontFace()) == (ru ? "KF Sable" : "NV Ancizar Serif"),
+            "reading role locale isolation failed");
+    require(localeReadingFamily("Libron") == (ru ? "NV Literata" : "Libron")
+                    && localeReadingFamily("NV Ancizar Serif") == (ru ? "KF Sable" : "NV Ancizar Serif")
+                    && localeReadingFamily("NV Legible Next") == (ru ? "NV Publica" : "NV Legible Next")
+                    && localeReadingFamily("User Custom") == "User Custom",
+            "old reading-role mapping changed custom font or wrong locale");
+    require(internationalSupplementalFont("Noto Serif"),
+            "RU Noto Serif replacement would be hidden as an unselected specialist fallback");
+    QVector<ReadingFont> fontChoices;
+    for (const auto *name : {"NV Adelph", "NV Aleo", "NV Andada", "NV Basker", "NV Castoro", "NV Yrsa",
+                             "KF Aleo", "Libron", "NV Legible Next", "NV Ancizar Serif", "Literata", "Lora", "Noto Serif", "User Custom", "NV Literata", "NV Publica", "KF Sable", "Kalam", "Instrument Serif"})
+        fontChoices.append(ReadingFont{QString::fromLatin1(name), {}, FontOrigin::Interface, {}, {}});
+    const auto visible = orderedReadingFonts(fontChoices, {"NV Aleo"});
+    require(visible.size() == (ru ? 4 : 18), "RU font exclusions or EN list isolation failed");
+    require(!QFileInfo::exists(test::readerAssets().file("fonts/Literata-Regular.ttf"))
+                    && !QFileInfo::exists(test::readerAssets().file("fonts/Lora-Italic.ttf"))
+                    && (bundledFontFiles(test::readerAssets()).contains(test::readerAssets().file("fonts/ebook-supplemental/KF_Sable-Regular.ttf")) == ru),
+            "redundant faces remain or uploaded KF Sable unavailable");
+    const ReadingFont latin{"Latin sample", {test::readerAssets().file("fonts/Kalam-Regular.ttf")}, FontOrigin::Interface, {}, {}};
+    const ReadingFont cyrillic{"Cyrillic sample", {test::readerAssets().file("fonts/ebook-core/NV_Literata-Regular.ttf")}, FontOrigin::Interface, {}, {}};
+    require(orderedReadingFonts({latin, cyrillic}).size() == (ru ? 1 : 2),
+            "actual cmap filter missing or leaked into English");
+
+    {
+        const auto presets = textpresets::load({});
+        require(presets[0].fontFace == localeDefaultFontFace()
+                        && presets[1].fontFace == localeBookishFontFace(),
+                "localized shipped reading presets use obsolete fonts");
+        const QByteArray book("<FictionBook xmlns='http://www.gribuser.ru/xml/fictionbook/2.0'>"
+                              "<body><section><p>Reading role sample.</p></section></body></FictionBook>");
+        for (const auto *old : {"Libron", "NV Ancizar Serif", "NV Legible Next"}) {
+            EngineDocument document(test::readerFonts());
+            QString error;
+            require(document.open(book, {600, 800}, {{"font_face", old}, {"default_font_face", "Libron"},
+                                                    {"koblaze_first_spine_item", -1}}, &error), qPrintable(error));
+            require(document.fontFace() == localeReadingFamily(QString::fromLatin1(old))
+                            && document.pages() > 0,
+                    "engine did not resolve old reading role to actual localized face");
