+#pragma once
+#include "header_footer.h"
+#include <QJsonObject>
+
+namespace kobalt::menustatus {
+inline constexpr auto preferenceKey = "reading_menu_status";
+inline bool showsPage(const QJsonObject &preferences)
+{
+    return preferences.value(preferenceKey).toString() == "book_page";
+}
+// Serialize the effective choice, including the existing fallback for invalid data.
+inline QString value(const QJsonObject &preferences)
+{
+    return showsPage(preferences) ? QStringLiteral("book_page") : QStringLiteral("session");
+}
+
+// Return a request for the existing preference writer, without changing live state.
+inline QJsonObject toggledPreferences(const QJsonObject &preferences)
+{
+    auto next = preferences;
+    next[preferenceKey] = showsPage(preferences) ? QStringLiteral("session")
+                                               : QStringLiteral("book_page");
+    return next;
+}
+inline QString text(const QJsonObject &preferences, const headerfooter::Values &values)
+{
+    return showsPage(preferences)
+            ? headerfooter::content(headerfooter::Field::BookPage, values, false).text
+            : QString();
+}
+} // namespace kobalt::menustatus
