+#include "check.h"
+#include "app/reader/views/navigation.h"
+#include "reading/features.h"
+#include "reading/page_navigation.h"
+#include "ui/controls/buttons.h"
+#include "ui/controls/panels.h"
+#include "ui/style/metrics.h"
+#include <QApplication>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <cstdio>
+
+using namespace kobalt;
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    QJsonObject preferences;
+    require(features::enabled(preferences, features::Activity)
+                    && features::enabled(preferences, features::DarkMode)
+                    && features::enabled(preferences, features::Comics),
+            "optional toolbar features changed upstream defaults");
+    preferences["disable_comics"] = true;
+    require(!features::enabled(preferences, features::Comics)
+                    && features::enabled(preferences, features::DarkMode)
+                    && features::enabled(preferences, features::Activity),
+            "comics feature is not independent");
+    require(QString::fromLatin1(pageNavigation::reverseSwipesKey) == "reverse_page_swipes",
+            "upstream independent swipe preference replaced");
+
+    QWidget parent;
+    ui::Panel toolbar(&parent, Qt::BottomEdge);
+    auto *rows = new QHBoxLayout(&toolbar);
+    ui::Button settings(&toolbar), bookmarks(&toolbar), dark(&toolbar), comics(&toolbar);
+    QLabel caption(&toolbar);
+    ToolbarComposition controls;
+    controls.panel = &toolbar;
+    controls.rows = rows;
+    controls.settings = &settings;
+    controls.bookmarks = &bookmarks;
+    controls.session = &caption;
+    controls.darkTheme = &dark;
+    controls.comics = &comics;
+    dark.setStyleSheet("QPushButton { padding: 1px; }");
+    comics.setStyleSheet("QPushButton { padding: 2px; }");
+    dark.setPaintMode(ui::ButtonPaintMode::ToolbarSquare);
+    comics.setPaintMode(ui::ButtonPaintMode::ToolbarSquare);
+    const auto darkStyle = dark.styleSheet(), comicsStyle = comics.styleSheet();
+    {
+        reader::Navigation navigation(&parent, controls);
+        require(dark.paintMode() == ui::ButtonPaintMode::ToolbarCell
+                        && comics.paintMode() == ui::ButtonPaintMode::ToolbarCell,
+                "quick actions not adapted to navigation cells");
+    }
+    require(dark.styleSheet() == darkStyle && comics.styleSheet() == comicsStyle
+                    && dark.paintMode() == ui::ButtonPaintMode::ToolbarSquare
+                    && comics.paintMode() == ui::ButtonPaintMode::ToolbarSquare,
+            "navigation did not restore borrowed quick actions");
+    const int size = ui::metrics::control::toolbarButtonSize;
+    require(dark.size() == QSize(size, size) && comics.size() == QSize(size, size),
+            "navigation left quick action cell dimensions behind");
+
+    comics.setCheckable(true);
+    comics.setHighlightChecked(false);
+    ui::ButtonIcon icon{ui::ControlIcon::Comics, ui::IconRendition::Action};
+    icon.stateInkOnly = true;
+    comics.setIconConfiguration(icon);
+    require(comics.iconShowsStateWithoutFill(), "comics icon lost ink-only state policy");
+    const auto before = comics.icon().pixmap(QSize(64, 64), QIcon::Normal, QIcon::Off).toImage();
+    const auto after = comics.icon().pixmap(QSize(64, 64), QIcon::Normal, QIcon::On).toImage();
+    require(!before.isNull() && !after.isNull() && before != after,
+            "comics icon does not distinguish on and off");
+    dark.setIconConfiguration({ui::ControlIcon::DarkTheme, ui::IconRendition::Action});
+    require(!dark.icon().pixmap(QSize(64, 64)).isNull(), "dark theme glyph missing");
+    std::puts("PASS: quick action ownership, feature independence and state glyphs");
+}
