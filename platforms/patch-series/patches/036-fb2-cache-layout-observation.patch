     /// check document formatting parameters before render - whether we need to reformat; returns false if render is necessary
     bool checkRenderContext();
+    // Per-document, non-serialized observation only. Never used to admit a cache.
+    struct KoblazeRenderCheck {
+        int checks = 0, rejected = 0, reasons = 0;
+        lUInt32 style = 0, savedStyle = 0, sheet = 0, savedSheet = 0;
+        lUInt32 flags = 0, savedFlags = 0;
+        int width = 0, savedWidth = 0, height = 0, savedHeight = 0;
+    };
+    KoblazeRenderCheck _koblazeRenderCheck;
+    void koblazeResetRenderCheck() { _koblazeRenderCheck = KoblazeRenderCheck(); }
