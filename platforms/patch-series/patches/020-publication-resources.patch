diff --git a/src/publication/fb2.h b/src/publication/fb2.h
new file mode 100644
index 00000000..0971642a
--- /dev/null
+++ b/src/publication/fb2.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <QByteArray>
+#include <cstring>
+
+namespace kobalt::fb2 {
+// Raw-byte FictionBook recognition. The payload is never decoded here: a
+// windows-1251 book keeps its encoding declaration and CREngine decodes it.
+// Callers pass at most the first 64 KiB. The root must fall within this
+// supported probe window; this is recognition, not full XML validation.
+inline bool matchesHead(const QByteArray &head) {
+    int at = 0;
+    if (head.startsWith("\xEF\xBB\xBF"))
+        at = 3;
+    // Do not mistake a tag mentioned in a comment, PI or another XML root
+    // for the document element. Keep this byte-based for legacy encodings.
+    if (head.contains("<!ENTITY"))
+        return false;
+    for (;;) {
+        while (at < head.size() &&
+               (head[at] == '\t' || head[at] == '\r' || head[at] == '\n' || head[at] == ' '))
+            ++at;
+        if (head.mid(at, 4) == "<!--") {
+            const int end = head.indexOf("-->", at + 4);
+            if (end < 0) return false;
+            at = end + 3;
+        } else if (head.mid(at, 2) == "<?") {
+            const int end = head.indexOf("?>", at + 2);
+            if (end < 0) return false;
+            at = end + 2;
+        } else if (head.mid(at, 9) == "<!DOCTYPE") {
+            // A declaration may contain quoted '>' or an internal subset.
+            // Entity declarations remain disallowed by the guard above.
+            int depth = 0;
+            char quote = 0;
+            int end = at + 9;
+            for (; end < head.size(); ++end) {
+                const char ch = head[end];
+                if (quote) {
+                    if (ch == quote) quote = 0;
+                } else if (ch == '\'' || ch == '"') quote = ch;
+                else if (ch == '[') ++depth;
+                else if (ch == ']') --depth;
+                else if (ch == '>' && !depth) break;
+                if (depth < 0) return false;
+            }
+            if (end == head.size()) return false;
+            at = end + 1;
+        } else break;
+    }
+    if (head.mid(at, 12) != "<FictionBook")
+        return false;
+    const int tag = at;
+    const int after = tag + int(std::strlen("<FictionBook"));
+    if (after >= head.size())
+        return false;
+    const char delimiter = head[after];
+    return delimiter == ' ' || delimiter == '\t' || delimiter == '\r' || delimiter == '\n' ||
+           delimiter == '>';
+}
+} // namespace kobalt::fb2
diff --git a/src/publication/fb2_resources.cpp b/src/publication/fb2_resources.cpp
new file mode 100644
index 00000000..f0db54a1
--- /dev/null
+++ b/src/publication/fb2_resources.cpp
@@ -0,0 +1,55 @@
+#include "fb2_resources.h"
+#include "support/strings.h"
+#include <QElapsedTimer>
+#include <QFile>
+
+namespace kobalt::fb2 {
+bool transferFile(const QString &path, qint64 expectedSize,
+                  const std::shared_ptr<SourceLease> &lease, const ResourceCache::Sink &sink,
+                  QString *error, qint64 &sinkNs)
+{
+    const auto cancelled = [&lease] { return !lease || lease->revoked(); };
+    auto fail = [&](const char *reason) {
+        if (error && error->isEmpty()) {
+            *error = strings::get(reason);
+        }
+        return false;
+    };
+    if (cancelled()) {
+        return fail("error.reading_session_closed");
+    }
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() != expectedSize) {
+        return fail("error.a_book_resource_changed_during_reading");
+    }
+    QElapsedTimer deadline;
+    deadline.start();
+    qint64 transferred = 0;
+    while (transferred < expectedSize) {
+        if (cancelled()) {
+            return fail("error.reading_session_closed");
+        }
+        if (deadline.elapsed() >= 5000) {
+            return fail("error.native_publication_transfer_timed_out");
+        }
+        const auto bytes = file.read(qMin(qint64(ResourceCache::blockBytes), expectedSize - transferred));
+        if (bytes.isEmpty()) {
+            return fail("error.could_not_load_a_book_resource");
+        }
+        QElapsedTimer work;
+        work.start();
+        if (!sink(bytes.constData(), bytes.size())) {
+            return false;
+        }
+        sinkNs += work.nsecsElapsed();
+        transferred += bytes.size();
+        if (file.size() != expectedSize)
+            return fail("error.a_book_resource_changed_during_reading");
+    }
+    if (cancelled())
+        return fail("error.reading_session_closed");
+    if (file.error() != QFile::NoError || file.size() != expectedSize || !file.atEnd())
+        return fail("error.a_book_resource_changed_during_reading");
+    return true;
+}
+} // namespace kobalt::fb2
