diff --git a/tests/model/fb2_cache_session.cpp b/tests/model/fb2_cache_session.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8d4c5236e564d52a901b72fd8aac62e6f6efc51a
--- /dev/null
+++ b/tests/model/fb2_cache_session.cpp
@@ -0,0 +1,102 @@
+#include "check.h"
+#include "reader_inputs.h"
+#include "reading/reader_session.h"
+#include "publication/local_resources.h"
+#include "app/messages/opening_message.h"
+#include <QGuiApplication>
+#include <QEventLoop>
+#include <QTimer>
+#include <QTemporaryDir>
+#include <QDir>
+#include <QFile>
+#include <cstdio>
+
+using namespace kobalt;
+namespace {
+void waitUntil(const std::function<bool()> &ready)
+{
+    if (ready()) return;
+    QEventLoop loop;
+    QTimer poll, deadline;
+    poll.setInterval(5);
+    QObject::connect(&poll, &QTimer::timeout, [&] { if (ready()) loop.quit(); });
+    deadline.setSingleShot(true);
+    QObject::connect(&deadline, &QTimer::timeout, [] { require(false, "FB2 cache session timeout"); });
+    poll.start(); deadline.start(30000); loop.exec();
+}
+void drain()
+{
+    bool done = false;
+    ReaderSession::drain([&] { done = true; });
+    waitUntil([&] { return done; });
+}
+QJsonObject cycle(const QString &path, const QString &cache, QJsonObject saved, bool expectHit)
+{
+    QJsonObject state;
+    {
+        ReaderSession reader(test::readerFonts(), test::readerPlaceholder());
+        auto lease = std::make_shared<SourceLease>();
+        OpenRequest request;
+        request.identity = request.path = path;
+        request.size = {600, 800};
+        request.saved = std::move(saved);
+        request.lease = lease;
+        request.resources = localResourceFactory(path, lease);
+        request.documentCachePath = cache;
+        request.positions = {
+            [](const Engine &, const QString &anchor, QString *) { return anchor; },
+            [](const Engine &engine, QString *) { return engine.position(); },
+            [](const QString &anchor) { return anchor; }
+        };
+        bool opened = false;
+        reader.open(std::move(request), [&](OpeningResult result) {
+            require(result.ready(), qPrintable(openingMessage(result)));
+            opened = true;
+        });
+        waitUntil([&] { return opened && !reader.busy(); });
+        require(!reader.image().isNull() && reader.pages() > 0, "session produced no readable frame");
+        require(reader.resourceStats().value("model_cache_hit").toBool() == expectHit,
+                expectHit ? "resource-backed session did not reuse parsed FB2 cache"
+                          : "cold/changed FB2 unexpectedly reused parsed cache");
+        state = reader.state();
+        // Exercise the real host close path. Discard the retained facade so the
+        // next cycle cannot pass through in-memory retained-book reuse.
+        auto retained = reader.retained();
+        drain(); // includes the queued cache write, while its engine is alive
+        retained.reset();
+    }
+    drain();
+    return state;
+}
+}
+int main(int argc, char **argv)
+{
+    QGuiApplication app(argc, argv);
+    QTimer::singleShot(0, &app, [&] {
+        QTemporaryDir root;
+        require(root.isValid(), "FB2 cache directory");
+        const auto path = root.filePath("book.fb2"), cache = root.filePath("parsed");
+        QByteArray book("<FictionBook xmlns='http://www.gribuser.ru/xml/fictionbook/2.0'>"
+                        "<description><title-info><book-title>Cache session</book-title>"
+                        "<lang>en</lang></title-info></description><body><section>");
+        for (int i = 0; i < 60; ++i)
+            book += "<p>Session cache paragraph " + QByteArray::number(i) + " with readable words.</p>";
+        // Preserve upstream's 64 KiB cache-lookup threshold without expensive layout.
+        book += "</section></body><!--" + QByteArray(128 * 1024, 'x') + "--></FictionBook>";
+        const auto write = [&] {
+            QFile file(path);
+            require(file.open(QIODevice::WriteOnly) && file.write(book) == book.size(), "write session fixture");
+        };
+        write();
+        auto saved = cycle(path, cache, {}, false);
+        require(!QDir(cache).entryList({"*.cr3"}, QDir::Files).isEmpty(),
+                "host close did not save parsed FB2 cache");
+        saved = cycle(path, cache, saved, true);
+        book.replace("Cache session", "Changed cache session");
+        write();
+        cycle(path, cache, saved, false);
+        std::puts("PASS: resource-backed FB2 session close/save/reopen and changed-source cache isolation");
+        app.quit();
+    });
+    return app.exec();
+}
