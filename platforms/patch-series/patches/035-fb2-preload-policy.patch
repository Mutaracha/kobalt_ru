diff --git a/platforms/kobo/common/book_menu.h b/platforms/kobo/common/book_menu.h
--- a/platforms/kobo/common/book_menu.h
+++ b/platforms/kobo/common/book_menu.h
@@ -4,6 +4,14 @@
 class QMenu;
 
 namespace kobalt {
+// Speculative Home-screen work is not an opening request. Raw FB2 can spend
+// seconds in full Render after cancellation, blocking the book the user taps.
+// Keep the normal manual FB2 route and upstream EPUB preload unchanged.
+inline bool readerBookPreloadAllowed(const QString &path)
+{
+    return !path.endsWith(QLatin1String(".fb2"), Qt::CaseInsensitive);
+}
+
 bool previewBook(const void *volume);
 // Metadata only: enough to show feedback, never permission to read a book.
 bool readerBookFormatSupported(const void *volume);
diff --git a/platforms/kobo/common/reader_coordinator.cpp b/platforms/kobo/common/reader_coordinator.cpp
--- a/platforms/kobo/common/reader_coordinator.cpp
+++ b/platforms/kobo/common/reader_coordinator.cpp
@@ -1447,6 +1447,10 @@
                 const auto path = record.value("path").toString();
                 // A plain EPUB that is still on the device. Protected books
                 // open in Nickel's reader and are never preloaded.
+                if (!readerBookPreloadAllowed(path)) {
+                    diagnostic("book-preload-skipped", { { "format", "fb2" } });
+                    return true;
+                }
                 if (identity.isEmpty() || !QFileInfo(path).isFile()
                     || !native::openLocalPublication(path))
                     return true;
