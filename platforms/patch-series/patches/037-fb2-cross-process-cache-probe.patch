+// CRLOG is used only while the sequential engine worker runs this probe.
+// Retain existing hash diagnostics, without changing the engine or its hash.
+class HashTrace : public CRLog {
+public:
+    HashTrace() : previous_(CRLOG) { curr_level = LL_INFO; CRLOG = this; }
+    ~HashTrace() override { CRLOG = previous_; }
+    QStringList lines;
+private:
+    void log(const char *, const char *format, va_list args) override {
+        if (!std::strstr(format, "Calculating style hash")
+                && !std::strstr(format, "Updating render properties")
+                && !std::strstr(format, "checkRenderContext:")) return;
+        char buffer[2048];
+        std::vsnprintf(buffer, sizeof(buffer), format, args);
+        if (lines.size() < 80) lines.append(QString::fromUtf8(buffer));
+    }
+    CRLog *previous_;
+};
+void writeJson(const QString &path, const QJsonObject &value) {
+    QFile file(path);
+    const auto bytes = QJsonDocument(value).toJson();
+    require(file.open(QIODevice::WriteOnly) && file.write(bytes) == bytes.size(),
+            "write cache process evidence");
+}
+QJsonObject readJson(const QString &path) {
+    QFile file(path);
+    require(file.open(QIODevice::ReadOnly), "read cache process evidence");
+    QJsonParseError error;
+    const auto doc = QJsonDocument::fromJson(file.readAll(), &error);
+    require(error.error == QJsonParseError::NoError && doc.isObject(), "invalid process evidence");
+    return doc.object();
+}
