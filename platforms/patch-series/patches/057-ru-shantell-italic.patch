+    require(ui::interfaceFont(32).italic() == (language == strings::Locale::Russian),
+            "RU Shantell must be italic, English Kalam remains upright");
+    require(!ui::interfaceInkBounds(QString::fromUtf8("Русский текст Ёж"), ui::interfaceFont(32)).isEmpty(),
+            "RU handwriting failed to measure Cyrillic");
+    ui::setInterfaceFontFamily({});
+    require(!ui::interfaceFont(32).italic(), "handwriting italic leaked into classic UI");
+    require(reader::customInterfaceStyle({{"ui_font_face", "Caveat"}}).mainFace
+                    == (language == strings::Locale::Russian ? "Shantell Sans" : "Caveat"),
