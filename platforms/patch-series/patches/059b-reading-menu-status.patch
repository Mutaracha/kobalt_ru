diff --git a/src/reading/menu_status.h b/src/reading/menu_status.h
new file mode 100644
index 00000000..eff1f413
--- /dev/null
+++ b/src/reading/menu_status.h
@@ -0,0 +1,17 @@
+#pragma once
+#include "header_footer.h"
+#include <QJsonObject>
+
+namespace kobalt::menustatus {
+inline constexpr auto preferenceKey = "reading_menu_status";
+inline bool showsPage(const QJsonObject &preferences)
+{
+    return preferences.value(preferenceKey).toString() == "book_page";
+}
+inline QString text(const QJsonObject &preferences, const headerfooter::Values &values)
+{
+    return showsPage(preferences)
+            ? headerfooter::content(headerfooter::Field::BookPage, values, false).text
+            : QString();
+}
+} // namespace kobalt::menustatus
