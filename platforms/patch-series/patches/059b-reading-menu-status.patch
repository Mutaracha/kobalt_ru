     // Uses the real reading clock and Settings checklist to hide session text without stopping time collection.
+    void readingMenuStatusToggle_data()
+    {
+        QTest::addColumn<bool>("dark");
+        for (bool dark : { false, true })
+            QTest::newRow(dark ? "night" : "day") << dark;
+    }
+
+    void readingMenuStatusToggle()
+    {
+        QFETCH(bool, dark);
+        QTemporaryDir books;
+        QVERIFY(test::writeBook(books.path(), "menu-status-a.epub", test::engineBook(false, 2, 1)));
+        QVERIFY(test::writeBook(books.path(), "menu-status-b.epub", test::engineBook(false, 3, 1)));
+        const auto paths = testPaths();
+        QVERIFY(storage::writeJson(paths.preferences(), { { "dark_mode", dark } }));
+        qint64 now = 0;
+        // Independent reader hosts model closing/reopening, including a different book.
+        for (int opening = 0; opening < 2; ++opening) {
+            ReaderFixture host(paths, testFonts, testPlaceholder);
+            host.readingClock = [&] { return now; };
+            CloseHost cleanup{ host };
+            QSignalSpy opened(&host, &ReaderFixture::opened);
+            const QSize size(1072, 1448);
+            host.open(books.filePath(opening ? "menu-status-b.epub" : "menu-status-a.epub"), size);
+            QTRY_COMPARE_WITH_TIMEOUT(opened.count(), 1, 30000);
+            Canvas canvas(host.window(), size);
+            canvas.resize(900, 900);
+            canvas.show();
+            QVERIFY(QTest::qWaitForWindowExposed(&canvas));
+            QTRY_VERIFY(!host.session()->busy());
+            QVERIFY(clickAt(canvas, QPoint(size.width() / 2, size.height() / 2)));
+            QTRY_VERIFY_WITH_TIMEOUT(!host.session()->paginationPending(), 30000);
+            auto *hit = host.window()->findChild<QAbstractButton *>("rrMenuStatusToggle");
+            auto *label = host.window()->findChild<QLabel *>("rrMenuSession");
+            auto *clock = host.window()->findChild<QLabel *>("rrMenuClock");
+            auto *battery = host.window()->findChild<QWidget *>("rrMenuBattery");
+            QVERIFY(hit && label && clock && battery);
+            QVERIFY(hit->isVisible());
+            QCOMPARE(hit->isChecked(), bool(opening));
+            const auto layoutStarts = host.session()->layoutStarts();
+            const auto position = host.session()->state().value("position");
+            const auto reading = host.book()->sessionReadingMilliseconds();
+            const auto clockBounds = clock->geometry();
+            const auto batteryBounds = battery->geometry();
+            for (int tap = 0; tap < 2; ++tap) {
+                QVERIFY(click(canvas, hit));
+                const bool pageMode = opening ? tap == 1 : tap == 0;
+                QCOMPARE(hit->isChecked(), pageMode);
+                QCOMPARE(storage::readPreferences(paths.preferences()).object
+                                 .value("reading_menu_status").toString(),
+                         pageMode ? QStringLiteral("book_page") : QStringLiteral("session"));
+                if (pageMode) {
+                    QVERIFY(label->isVisible());
+                    QVERIFY(!label->text().isEmpty());
+                } else {
+                    QVERIFY(label->text().isEmpty()); // first minute: no session caption
+                }
+                QVERIFY(clock->isVisible() && battery->isVisible());
+                QCOMPARE(clock->geometry(), clockBounds);
+                QCOMPARE(battery->geometry(), batteryBounds);
+                QCOMPARE(host.session()->layoutStarts(), layoutStarts);
+                QCOMPARE(host.session()->state().value("position"), position);
+                QCOMPARE(host.book()->sessionReadingMilliseconds(), reading);
+            }
+            if (!opening) {
+                QVERIFY(click(canvas, hit)); // leave page mode saved for the next host/book
+                QVERIFY(hit->isChecked());
+            }
+        }
+    }
