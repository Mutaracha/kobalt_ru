@@ -10,6 +10,30 @@ namespace kobalt {
 struct ReaderSourceIndexProbe
 {
     using Ranges = QVector<QPair<QString, QString>>;
+    static bool comicsGeometry(const EngineDocument &model) {
+        const auto margins = model.engine_->getPageMargins();
+        return margins.left == 0 && margins.top == 0 && margins.right == 0
+                && margins.bottom == 0 && model.columns_ == 1;
+    }
+    static QRect nodeBounds(const EngineDocument &model, const char *id) {
+        auto *root = model.engine_->getDocument()->getRootNode();
+        std::vector<ldomNode *> pending{root};
+        const auto wanted = QString::fromLatin1(id);
+        while (!pending.empty()) {
+            auto *node = pending.back(); pending.pop_back();
+            if (!node || !node->isElement()) continue;
+            const auto value = QString::fromUtf8(UnicodeToUtf8(node->getAttributeValue("id")).c_str());
+            // CREngine separates the EPUB fragment prefix with "_ ".
+            if (value == wanted || value.endsWith("_" + wanted) || value.endsWith("_ " + wanted)) {
+                lvRect rect;
+                node->getAbsRect(rect);
+                return QRect(rect.left, rect.top, rect.width(), rect.height());
+            }
+            for (int i = 0; i < node->getChildCount(); ++i) pending.push_back(node->getChildNode(i));
+        }
+        return {};
+    }
+
 
     static lString32 cre(const QString &text) { return Utf8ToUnicode(text.toUtf8().constData()); }
 
