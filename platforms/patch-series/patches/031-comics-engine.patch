@@ -0,0 +1,403 @@
+#include "check.h"
+#include "reader_inputs.h"
+#include "reader_source_index_probe.h"
+#include "reading/appearance_settings.h"
+#include "engine/blaze/adapter/page_draw_buffer.h"
+#include "engine/blaze/adapter/reader_comics.h"
+#include <QBuffer>
+#include <QGuiApplication>
+#include <QTemporaryDir>
+
+using namespace kobalt;
+
+static QRect inkBounds(const QImage &image)
+{
+    QRect bounds;
+    for (int y = 0; y < image.height(); ++y)
+        for (int x = 0; x < image.width(); ++x) {
+            const auto pixel = image.pixel(x, y);
+            if (qRed(pixel) > 200 && qGreen(pixel) < 40 && qBlue(pixel) < 40)
+                bounds = bounds.united(QRect(x, y, 1, 1));
+        }
+    return bounds;
+}
+
+// The renderer is shared, not reimplemented by the fork comics path.
+static void commonDrawBufferContract()
+{
+    QImage image(8, 8, QImage::Format_RGB32);
+    image.fill(Qt::white);
+    PageDrawBuffer normalized(image, false, true, true);
+    normalized.SetTextColor(0x123456);
+    require(normalized.GetTextColor() == 0, "Shared buffer lost text-ink normalization");
+    const lUInt8 bitmap[] = { 255, 255, 255, 255 };
+    normalized.Draw(-10, -10, bitmap, 2, 2, nullptr);
+    require(!normalized.hasText, "Clipped text was counted as visible");
+    normalized.Draw(1, 1, bitmap, 2, 2, nullptr);
+    require(normalized.hasText && !normalized.hasImages && normalized.imageRegions.isEmpty(),
+            "Shared buffer changed text/image metadata");
+    PageDrawBuffer publisher(image, false, true, false);
+    publisher.SetTextColor(0x123456);
+    require(publisher.GetTextColor() == 0x123456, "Shared buffer lost publisher text ink");
+}
+
+static void effectiveComicLayoutContract()
+{
+    const lvRect base(11, 22, 11, 33);
+    for (int columns : { 0, 1, 2, 3 }) {
+        const auto off = comicPageLayout(false, columns, base);
+        require(off.columns == columns && off.margins.left == 11 && off.margins.top == 22
+                        && off.margins.right == 11 && off.margins.bottom == 33,
+                "Disabled comics overlay changed base layout or validation policy");
+        const auto on = comicPageLayout(true, columns, base);
+        require(on.columns == 1 && on.margins.left == 0 && on.margins.top == 0
+                        && on.margins.right == 0 && on.margins.bottom == 0,
+                "Enabled comics overlay did not suppress effective margins/columns");
+    }
+    require(base.left == 11 && base.top == 22 && base.right == 11 && base.bottom == 33,
+            "Effective overlay mutated its base input");
+}
+
+int main(int argc, char **argv)
+{
+    QGuiApplication app(argc, argv);
+    commonDrawBufferContract();
+    effectiveComicLayoutContract();
+    // Same proportions and inline/div structure as the supplied KCC page,
+    // but synthetic solid art makes geometry independently measurable.
+    QImage art(1160, 1680, QImage::Format_RGB32);
+    art.fill(Qt::red);
+    QByteArray png;
+    QBuffer buffer(&png);
+    require(buffer.open(QIODevice::WriteOnly) && art.save(&buffer, "PNG"), "Encode comic art");
