+namespace {
+// Picker-only cmap check: never unregister engine faces or fallback resources.
+bool lacksRussianLetters(const ReadingFont &font)
+{
+    if (!russianFontRoles() || font.files.isEmpty()) return false;
+    static QMap<QString, bool> coverage;
+    bool inspected = false;
+    for (const auto &path : font.files) {
+        const QFileInfo info(path);
+        const auto key = path + ':' + QString::number(info.size()) + ':'
+                + QString::number(info.lastModified().toMSecsSinceEpoch());
+        if (!coverage.contains(key)) {
+            FT_Library library = nullptr;
+            FT_Face face = nullptr;
+            if (FT_Init_FreeType(&library)) continue;
+            if (FT_New_Face(library, QFile::encodeName(path).constData(), 0, &face)) {
+                FT_Done_FreeType(library);
+                continue; // Unknown/unreadable does not prove missing glyphs.
+            }
+            bool supported = FT_Get_Char_Index(face, 0x401) && FT_Get_Char_Index(face, 0x451);
+            for (unsigned c = 0x410; c <= 0x44f && supported; ++c)
+                supported = FT_Get_Char_Index(face, c) != 0;
+            FT_Done_Face(face);
+            FT_Done_FreeType(library);
+            if (coverage.size() > 2048) coverage.clear();
+            coverage.insert(key, supported);
+        }
+        inspected = true;
+        if (coverage.value(key)) return false;
+    }
+    return inspected;
+}
