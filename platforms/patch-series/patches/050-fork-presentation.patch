diff --git a/tests/model/debug_language_ui.cpp b/tests/model/debug_language_ui.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e17b951e8064417e7fad1ac0b5f8a8108ad3796f
--- /dev/null
+++ b/tests/model/debug_language_ui.cpp
@@ -0,0 +1,64 @@
+#include "check.h"
+#include "app/reader/settings/debug_language_dialog.h"
+#include "support/debug_language.h"
+#include "support/strings.h"
+#include "ui/controls/options.h"
+#include <QApplication>
+#include <QDir>
+#include <QEventLoop>
+#include <QPushButton>
+#include <QTemporaryDir>
+#include <QTimer>
+#include <cstdio>
+using namespace kobalt;
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    QTemporaryDir directory;
+    require(directory.isValid(), "language UI directory");
+    strings::setLocale(strings::Locale::Russian);
+    QWidget host;
+    host.resize(1000, 1200);
+    QPushButton button(&host);
+    button.setGeometry(0, 0, 200, 60);
+    reader::installDebugLanguageChooser(&button, &host, directory.path());
+    host.show();
+    button.click();
+    app.processEvents();
+    auto *popup = host.findChild<QWidget *>("rrDebugLanguage");
+    require(popup && popup->isVisible(), "language chooser did not open");
+    auto *cancel = popup->findChild<QPushButton *>("rrDebugLanguageClose");
+    require(cancel, "language chooser cancel missing");
+    cancel->click();
+    require(!popup->isVisible() && debugLanguage(directory.path()) == DebugLanguage::Automatic,
+            "cancel changed persistent locale or left chooser visible");
+    button.click();
+    app.processEvents();
+    // The previous popup is pending deleteLater: select the visible one only.
+    popup = nullptr;
+    for (auto *candidate : host.findChildren<QWidget *>("rrDebugLanguage"))
+        if (candidate->isVisible()) popup = candidate;
+    require(popup, "language chooser did not reopen");
+    auto *english = popup->findChild<QCheckBox *>("rrDebugLanguageEnglish");
+    cancel = popup->findChild<QPushButton *>("rrDebugLanguageClose");
+    require(english && cancel, "language choices missing");
+    english->click();
+    require(!cancel->isEnabled(), "async language save did not disable submission");
+    QEventLoop loop;
+    QTimer poll, timeout;
+    timeout.setSingleShot(true);
+    QObject::connect(&poll, &QTimer::timeout, &loop, [&] {
+        if (cancel->isEnabled()) loop.quit();
+    });
+    QObject::connect(&timeout, &QTimer::timeout, &loop, &QEventLoop::quit);
+    poll.start(10);
+    timeout.start(5000);
+    loop.exec();
+    require(cancel->isEnabled() && debugLanguage(directory.path()) == DebugLanguage::English,
+            "language choice not saved asynchronously");
+    require(strings::locale() == strings::Locale::Russian,
+            "language chooser partially retranslated live UI");
+    cancel->click();
+    require(!popup->isVisible(), "saved language chooser did not close");
+    std::puts("PASS: language chooser cancellation, reopen and asynchronous save");
+}
