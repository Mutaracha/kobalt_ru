diff --git a/src/support/locale.cpp b/src/support/locale.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..64f8e0465f2e021bbdda96012049b678522e4b33
--- /dev/null
+++ b/src/support/locale.cpp
@@ -0,0 +1,58 @@
+#include "support/locale.h"
+
+#include "support/qt_compat.h"
+
+#include <QFileInfo>
+#include <QLocale>
+#include <QSettings>
+#include <QString>
+#include <QStringList>
+
+namespace kobalt {
+namespace {
+constexpr auto koboReaderConf = "/mnt/onboard/.kobo/Kobo/Kobo eReader.conf";
+} // namespace
+
+strings::Locale localeFromKoboConfig(const QString &confPath) {
+    const QFileInfo info(confPath);
+    if (!info.isFile() || !info.isReadable())
+        return strings::Locale::English;
+    const QSettings settings(confPath, QSettings::IniFormat);
+    // Localization patches always register their language in ExtraLocales,
+    // while older patches leave CurrentLocale at the placeholder "C". The
+    // value is a comma-separated list (e.g. "ru" or "en_GB, ru_RU"), so a
+    // Russian token there is the most reliable sign of a Russian device.
+    // QSettings parses unquoted comma-separated INI values as QStringList;
+    // a quoted list stays a single QString. Accept both representations.
+    const auto extraLocales = settings.value("ApplicationPreferences/ExtraLocales").toStringList();
+    for (const auto &locales : extraLocales) {
+        for (const auto &token : locales.split(QLatin1Char(','), kobalt::qt::skipEmptyParts)) {
+            if (strings::normalizeLocaleCode(token.trimmed()) == strings::Locale::Russian)
+                return strings::Locale::Russian;
+        }
+    }
+    const auto code = settings.value("ApplicationPreferences/CurrentLocale").toString();
+    // "C" and "POSIX" mean no real locale selection, as shipped by old patches.
+    if (code.isEmpty() || code == QLatin1String("C") || code == QLatin1String("POSIX"))
+        return strings::Locale::English;
+    return strings::normalizeLocaleCode(code);
+}
+
+strings::Locale resolveLocale(const QString &diagnosticsDirectory) {
+    // A persistent explicit debug choice wins even if Nickel's environment
+    // carries a locale override. Automatic retains the previous ENV/config chain.
+    switch (debugLanguage(diagnosticsDirectory)) {
+    case DebugLanguage::English: return strings::Locale::English;
+    case DebugLanguage::Russian: return strings::Locale::Russian;
+    case DebugLanguage::Automatic: break;
+    }
+    const auto forced = qgetenv("KOBALT_LANGUAGE");
+    if (!forced.isEmpty())
+        return strings::normalizeLocaleCode(QString::fromLatin1(forced));
+    // On a Kobo the firmware config is authoritative when it exists. Desktop
+    // and Android builds have no such file and follow the system locale.
+    if (QFileInfo::exists(QString::fromLatin1(koboReaderConf)))
+        return localeFromKoboConfig(QString::fromLatin1(koboReaderConf));
+    return strings::normalizeLocaleCode(QLocale::system().name());
+}
+} // namespace kobalt
diff --git a/src/support/locale.h b/src/support/locale.h
new file mode 100644
index 0000000000000000000000000000000000000000..4d759e6e068f2527c8ea1324bab95a5fee20cec7
--- /dev/null
+++ b/src/support/locale.h
@@ -0,0 +1,16 @@
+#pragma once
+#include "support/strings.h"
+#include "support/debug_language.h"
+
+
+namespace kobalt {
+// Resolve the interface locale once at startup. The order is:
