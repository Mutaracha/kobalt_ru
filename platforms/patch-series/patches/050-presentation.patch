+++ b/src/app/reader/views/sleep_letter_text.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <QString>
+#include <QStringList>
+
+namespace kobalt::reader::sleeptext {
+// Letter templates use single-digit slots. Substitute template slots only:
+// inserted (already escaped/styled) metadata is never interpreted again.
+// This helper does not escape HTML; callers retain that responsibility.
+inline QString fill(const QString &text, const QStringList &values)
+{
+    QString result;
+    for (int i = 0; i < text.size(); ++i) {
+        if (text[i] == QLatin1Char('%') && i + 1 < text.size()) {
+            const int index = text[i + 1].digitValue() - 1;
+            if (index >= 0 && index < values.size()) {
+                result += values[index];
+                ++i;
+                continue;
+            }
+        }
+        result += text[i];
+    }
+    return result;
+}
+} // namespace kobalt::reader::sleeptext
