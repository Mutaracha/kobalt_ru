+void savedPresetNames()
+{
+    struct Name { const char *id; const char *english; const char *russian; };
+    const Name names[] = {
+        {"kobalt", "Kobalt", "Kobalt"}, {"bookish", "Bookish", "Книжный"},
+        {"modern", "Modern", "Современный"}, {"classic", "Classic", "Классический"}
+    };
+    for (auto locale : {strings::Locale::English, strings::Locale::Russian}) {
+        strings::setLocale(locale);
+        for (bool keys : {false, true}) {
+            strings::showKeys(keys);
+            for (const auto &name : names) {
+                const auto key = QByteArray("text_presets.example_") + name.id;
+                for (const auto *savedName : {name.english, name.russian}) {
+                    textpresets::Preset preset;
+                    preset.id = QString::fromLatin1(name.id);
+                    preset.name = QString::fromUtf8(savedName);
+                    preset.example = true;
+                    preset.halfPoints = 37;
+                    preset.fontFace = QStringLiteral("User font");
+                    const auto before = preset;
+                    require(strings::matchesTranslation(key.constData(), preset.name),
+                            "Saved EN/RU name was not recognized");
+                    require(textpresets::displayName(preset) == strings::get(key.constData())
+                                    && preset == before,
+                            "Display-name localization modified persisted preset fields");
+                    preset.example = false;
+                    require(textpresets::displayName(preset) == preset.name,
+                            "User preset with a shipped name was translated");
+                    preset.example = true;
+                    preset.id = QStringLiteral("user-defined");
+                    require(textpresets::displayName(preset) == preset.name,
+                            "Unknown example id was translated");
+                }
+                for (const auto &custom : {QString(), QStringLiteral("My name"),
+                                           QString::fromUtf8(name.english).toLower(),
+                                           QString::fromUtf8(name.english) + QLatin1Char(' ')}) {
+                    textpresets::Preset preset;
+                    preset.id = QString::fromLatin1(name.id);
+                    preset.name = custom;
+                    preset.example = true;
+                    require(!strings::matchesTranslation(key.constData(), custom)
+                                    && textpresets::displayName(preset) == custom,
+                            "Renamed, empty or differently cased preset was translated");
+                }
+            }
+            require(!strings::matchesTranslation("missing.preset.key", QStringLiteral("missing.preset.key"))
+                            && !strings::matchesTranslation("missing.preset.key", QString()),
+                    "Missing key was treated as shipped copy");
+            require(strings::locale() == locale && strings::keyDisplay().load() == keys,
+                    "Name recognition changed locale or key-display state");
+        }
+    }
+    strings::showKeys(false);
+    strings::setLocale(strings::Locale::English);
+}
+
+void letterTemplateSubstitution()
+{
+    using reader::sleeptext::fill;
+    require(fill(QStringLiteral("%2 / %1 / %2"), {QStringLiteral("A"), QStringLiteral("B")})
+                    == QStringLiteral("B / A / B"),
+            "Letter template changed repeated or reordered slots");
+    require(fill(QStringLiteral("%1|%2|%3"),
+                 {QStringLiteral("22%"), QStringLiteral("<i>Book %3 &amp; %1</i>"),
+                  QStringLiteral(" Chapter %2.")})
+                    == QStringLiteral("22%|<i>Book %3 &amp; %1</i>| Chapter %2."),
+            "Letter substituted placeholders inside metadata or changed markup/percent");
+    require(fill(QStringLiteral("%1.%2"), {QStringLiteral("Book"), QString()})
+                    == QStringLiteral("Book."),
+            "Empty optional Letter suffix was not removed");
+    require(fill(QStringLiteral("%0 %9 %x %"), {QStringLiteral("A")})
+                    == QStringLiteral("%0 %9 %x %"),
+            "Letter changed unsupported or missing slots");
+    require(fill(QStringLiteral("%10"), {QStringLiteral("A")}) == QStringLiteral("A0"),
+            "Letter single-digit slot grammar changed");
+    require(fill(QStringLiteral("%%1"), {QStringLiteral("A")}) == QStringLiteral("%A"),
+            "Letter literal percent handling changed");
+    require(fill(QString(), {QStringLiteral("A")}).isEmpty()
+                    && fill(QStringLiteral("%1"), {}) == QStringLiteral("%1"),
+            "Letter empty template/value-list behavior changed");
+    for (auto locale : {strings::Locale::English, strings::Locale::Russian}) {
+        strings::setLocale(locale);
+        const auto title = QStringLiteral("<i>Title %3</i>");
+        const auto chapter = fill(strings::get("sleep.letter_chapter"),
+                                  {QStringLiteral("Chapter %1")});
+        for (const auto *key : {"sleep.letter_progress", "sleep.letter_progress_off"}) {
+            const auto text = fill(strings::get(key), {QStringLiteral("22%"), title, chapter});
+            require(text.contains(title) && text.contains(chapter)
+                            && text.count(QStringLiteral("22%")) == 1,
+                    "Localized Letter progress reinterpreted metadata");
+            require(fill(strings::get(key), {QStringLiteral("22%"), title, QString()})
+                            .contains(title),
+                    "Letter without chapter lost the title");
+        }
+        for (const auto *key : {"sleep.letter_finished", "sleep.letter_finished_off"})
+            require(fill(strings::get(key), {title}).contains(title),
+                    "Finished Letter reinterpreted the title");
+        const auto duration = QStringLiteral("18") + QChar(0x00a0) + QStringLiteral("h");
+        require(fill(strings::get("sleep.letter_remaining"), {duration}).contains(duration),
+                "Letter remaining time changed its no-break space");
+    }
+    strings::setLocale(strings::Locale::English);
+}
+
+void toolbarActionRoundTrip()
+{
+    using namespace reader::forkui;
+    QString untouched = QStringLiteral("unchanged");
+    auto paint = ui::ButtonPaintMode::OutlinedAction;
+    styleToolbarAction(nullptr, untouched, paint);
+    restoreToolbarAction(nullptr, untouched, paint);
+    require(untouched == QStringLiteral("unchanged")
+                    && paint == ui::ButtonPaintMode::OutlinedAction,
+            "Absent toolbar action changed saved state");
+    ui::Button dark;
+    ui::Button comics;
+    QPushButton plain;
+    dark.setPaintMode(ui::ButtonPaintMode::OutlinedAction);
+    comics.setPaintMode(ui::ButtonPaintMode::ToolbarSquare);
+    int index = 0;
+    for (auto *action : {static_cast<QPushButton *>(&dark),
+                         static_cast<QPushButton *>(&comics), &plain}) {
+        const auto originalStyle = QStringLiteral("QPushButton{padding:%1px;}").arg(++index);
+        action->setStyleSheet(originalStyle);
+        action->setCheckable(true);
+        action->setChecked(true);
+        action->setEnabled(false);
+        auto *button = dynamic_cast<ui::Button *>(action);
+        const auto originalPaint = button ? button->paintMode() : ui::ButtonPaintMode::Native;
+        for (int cycle = 0; cycle < 3; ++cycle) {
+            QString savedStyle;
+            auto savedPaint = ui::ButtonPaintMode::Native;
+            styleToolbarAction(action, savedStyle, savedPaint);
+            require(savedStyle == originalStyle
+                            && action->size() == QSize(ui::metrics::chrome::cellWidth,
+                                                       ui::metrics::chrome::actionHeight),
+                    "Navigation did not capture style or apply toolbar geometry");
+            require(!button || button->paintMode() == ui::ButtonPaintMode::ToolbarCell,
+                    "Navigation did not apply toolbar paint mode");
+            restoreToolbarAction(action, savedStyle, savedPaint);
+            require(action->styleSheet() == originalStyle
+                            && action->size() == QSize(ui::metrics::control::toolbarButtonSize,
+                                                       ui::metrics::control::toolbarButtonSize)
+                            && (!button || button->paintMode() == originalPaint),
+                    "Toolbar action did not restore its own style, geometry and paint mode");
+            require(action->isCheckable() && action->isChecked() && !action->isEnabled(),
+                    "Toolbar styling changed action state");
+        }
+    }
+}
+} // namespace
+// Checks retained presentation on both languages/densities without changing saved presets.
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    toolbarActionRoundTrip();
+    letterTemplateSubstitution();
+    savedPresetNames();
+    require(ui::initializeInterfaceFonts(test::readerAssets()), "presentation fonts unavailable");
+    QImage letterSignatures[2][2];
+    for (auto locale : {strings::Locale::English, strings::Locale::Russian}) {
+        strings::setLocale(locale);
+        if (locale == strings::Locale::Russian) {
+            for (auto key : {"debug.evict_cache_description", "debug.evict_cache_confirm_description",
+                             "debug.clear_caches_description", "debug.clear_caches_confirm_description"})
+                require(strings::get(key).contains(QStringLiteral("Kobalt")),
+                        "Cache eviction must identify Kobalt as the application being closed");
+        }
+        // Compare actual signature pixels across locales, not only QFont metadata.
+        // English is the original Instrument Serif reference; localized prose is
+        // clipped above this crop. Cover both sleep and power-off, day and night.
+        for (int dark = 0; dark < 2; ++dark) {
+            for (int off = 0; off < 2; ++off) {
+                sleep::Snapshot shot;
+                shot.design = sleep::Design::Letter;
+                shot.dark = dark;
+                shot.dimPage = false;
+                shot.percent = 42;
+                const QSize size(1072, 1448);
+                QImage backdrop(size, QImage::Format_RGB32);
+                backdrop.fill(dark ? Qt::black : Qt::white);
+                const auto image = reader::sleepDesignImage(backdrop, shot, 67,
+                        off ? reader::SleepStatus::PoweredOff : reader::SleepStatus::Sleeping);
+                const auto font = ui::wordmarkFont(qRound(11 * 10.72));
+                const int top = qCeil(1448 * .88 - ui::interfaceLineHeight(font) * 1.1) + 2;
+                const auto signature = image.copy(0, top, size.width(), size.height() - top);
+                require(!signature.isNull(), "Letter signature crop unavailable");
+                bool ink = false;
+                for (int y = 0; y < signature.height(); ++y)
+                    for (int x = 0; x < signature.width(); ++x)
+                        ink |= signature.pixel(x, y) != signature.pixel(signature.width()-1, y);
+                require(ink, "Letter signature is blank");
+                if (locale == strings::Locale::English)
+                    letterSignatures[dark][off] = signature;
+                else
+                    require(signature == letterSignatures[dark][off],
+                            "Russian sleep/power-off letter changed the Instrument Serif signature");
+            }
+        }
+        const auto duration = QStringLiteral("123 h 45 min");
+        const auto remaining = strings::get("sleep.time_left").arg(duration);
+        const auto lines = reader::sleepRibbonRemainingLines(remaining);
+        require(lines.size() == 2 && lines.join(' ').contains(duration),
+                "ribbon did not retain duration in two localized lines");
+        require(lines[locale == strings::Locale::English ? 0 : 1] == duration,
+                "ribbon reversed language order");
+        require(reader::sleepRibbonRemainingLines({}).isEmpty(), "empty remaining gained a caption");
+        require(reader::sleepRibbonRemainingLines("legacy unrelated status")
+                        == QStringList{"legacy unrelated status"}, "old snapshot status misparsed");
+        auto presets = textpresets::examples();
+        require(!presets.isEmpty(), "shipped presets unavailable");
+        auto preset = presets.first();
+        const auto saved = preset;
+        require(textpresets::displayName(preset) == strings::get("text_presets.example_kobalt")
+                        && preset == saved, "example localization changed saved values");
+        preset.name = QStringLiteral("My custom name");
+        require(textpresets::displayName(preset) == preset.name, "renamed preset translated");
+        preset.id = "user-defined";
+        require(textpresets::displayName(preset) == preset.name, "unknown preset translated");
+        ui::InterfaceLabel exitTitle(strings::get("reader.exit"));
+        exitTitle.setFont(ui::interfaceFont(36));
+        const auto runs = ui::returnTitleRuns(exitTitle);
+        require(runs.size() == 2 && !runs[0].second.italic()
+                        && runs[0].second.family() == ui::brandFont(36, false).family()
+                        && runs[1].second.family() == QStringLiteral("Instrument Serif")
+                        && !runs[1].second.italic(), "return title mixed interface/wordmark roles");
+        require(ui::styles::heading(36).contains("font-style:normal"), "heading inherited italics");
+        require(ui::brandFont(36, true).italic(), "original beta10 italic request lost");
+        if (locale == strings::Locale::Russian) {
+            require(ui::brandFont(36, true).family() == QStringLiteral("Noto Serif Display Condensed"),
+                    "wrong Russian italic family");
+            require(!test::readerAssets().manifestFontData("NotoSerifDisplay_Condensed-Regular.ttf").isEmpty()
+                            && !test::readerAssets().manifestFontData("NotoSerifDisplay_Condensed-Italic.ttf").isEmpty()
+                            && !QFileInfo::exists(test::readerAssets().file("fonts/MTCORSVA.TTF")),
+                    "Russian font subset did not replace Corsiva");
+        }
+        require(ui::brandFont(100).pixelSize() == (locale == strings::Locale::Russian ? 85 : 100)
+                        && ui::wordmarkFont(100).pixelSize() == 100,
+                "locale optical scale changed the wordmark or English serif");
+        require(ui::styles::heading(100).contains(locale == strings::Locale::Russian
+                        ? "font-size:85px" : "font-size:100px"), "QSS ignored optical scale");
+        exitTitle.setFont(ui::brandFont(100));
+        exitTitle.setProperty("wordmark_pixels", 100);
+        const auto scaledRuns = ui::returnTitleRuns(exitTitle);
+        require(scaledRuns[0].second.pixelSize() == (locale == strings::Locale::Russian ? 90 : 100)
+                        && scaledRuns[1].second.pixelSize() == 100,
+                "exit prefix double-scaled or Kobalt resized");
+        AboutPage about;
+        auto *aboutWordmark = about.findChild<QLabel *>("rrAboutWordmark");
+        require(aboutWordmark
+                        && aboutWordmark->property("reader_style").toString().contains("Instrument Serif")
+                        && !aboutWordmark->property("reader_style").toString().contains("Monotype Corsiva"),
+                "About wordmark inherited the localized heading font");
+        aboutWordmark->ensurePolished();
+        require(aboutWordmark->font().family() == QStringLiteral("Instrument Serif")
+                        && !aboutWordmark->font().italic(),
+                "About did not resolve the regular Instrument Serif brand face");
+        require(bool(about.findChild<QLabel *>("rrAboutFork")) == (kobaltForkName[0] != '\0'),
+                "About fork row ignored configured distribution");
+        require(!about.findChild<QPushButton *>("rrDebugLanguageButton"),
+                "language entry returned to About");
+        for (int ppi : {212, 300}) {
+            ui::setDensity(ppi);
+            ui::InterfaceLabel title(QString::fromUtf8("Вернуться в Kobalt"));
+            title.setFont(ui::interfaceFont(ui::px(36)));
+            require(ui::returnTitleSizeHint(title).width() > 0, "return title not measured");
+            for (bool dark : {false, true}) {
+                QWidget host;
+                host.setProperty("reader_dark", dark);
+                host.setPalette(ui::readerPalette(host.palette(), dark));
+                for (int width : {ui::px(110), ui::px(160)}) {
+                    ui::HighlightSwatch swatch("gray", strings::get("annotations.color_gray"), &host);
+                    swatch.resize(width, swatch.height());
+                    swatch.setChecked(dark);
+                    const auto image = swatch.grab().toImage();
+                    const auto paper = image.pixelColor(ui::px(4), ui::px(4));
+                    auto inked = [&](int y) {
+                        for (int x = 0; x < image.width(); ++x)
+                            if (qAbs(qGray(image.pixel(x,y)) - paper.lightness()) > 100) return true;
+                        return false;
+                    };
+                    bool label = false;
+                    for (int y = image.height()*2/3; y < image.height()-1; ++y) label |= inked(y);
+                    require(label && !inked(image.height()-1), "annotation label missing or clipped");
+                }
+                QImage page(800, 1200, QImage::Format_RGB32);
+                page.fill(Qt::white);
+                const auto frame = reader::sleepScreenImage(page, "99%", remaining, dark,
+                        99, reader::SleepStatus::Sleeping, true, sleep::Tile::Bookmark, 99);
+                require(!frame.isNull() && frame.size() == page.size(), "sleep ribbon render failed");
+            }
+        }
+    }
+    std::puts("PASS: bilingual sleep ribbon, annotation labels, About and preset presentation");
+}
