new file mode 100644
index 00000000..0c7ab986
--- /dev/null
+++ b/src/app/reader/views/fork_navigation.cpp
@@ -0,0 +1,63 @@
+#include "ui/controls/rows.h"
+#include <QEvent>
+#include "fork_navigation.h"
+#include "navigation.h"
+#include "support/strings.h"
+#include "ui/style/fonts.h"
+#include "ui/style/styles.h"
+#include "ui/controls/text.h"
+#include <QPushButton>
+
+namespace kobalt::reader {
+namespace chrome = ui::metrics::chrome;
+
+// Use one shared ink height for all translated labels. Latin H alone is
+// shorter than Cyrillic Д (in НАВИГАЦИЯ/РАСКЛАДКА); the private text painter
+// clips to this area after centering, otherwise cutting both edges of Д.
+QRect forkui::tabInkBounds(int pixels)
+{
+    QString sample = QStringLiteral("H");
+    for (const auto *key : { "navigation.chapters", "navigation.seek", "navigation.text",
+                             "navigation.layout", "navigation.light", "navigation.stats" })
+        sample += QLatin1Char(' ') + strings::get(key);
+    return ui::interfaceInkBounds(sample, ui::interfaceFont(pixels));
+}
+
+void forkui::styleToolbarAction(QPushButton *action, QString &savedStyle,
+                                 ui::ButtonPaintMode &savedPaint)
+{
+    if (!action)
+        return;
+    savedStyle = action->styleSheet();
+    ui::readerStyle(action, "QPushButton{border:none;padding:0;}");
+    action->setFixedSize(chrome::cellWidth, chrome::actionHeight);
+    if (auto *button = dynamic_cast<ui::Button *>(action)) {
+        savedPaint = button->paintMode();
+        button->setPaintMode(ui::ButtonPaintMode::ToolbarCell);
+    }
+}
+
+void forkui::restoreToolbarAction(QPushButton *action, const QString &savedStyle,
+                                   ui::ButtonPaintMode savedPaint)
+{
+    if (!action)
+        return;
+    action->setStyleSheet(savedStyle);
+    action->setFixedSize(ui::metrics::control::toolbarButtonSize,
+                         ui::metrics::control::toolbarButtonSize);
+    if (auto *button = dynamic_cast<ui::Button *>(action))
+        button->setPaintMode(savedPaint);
+}
+
+void Navigation::styleForkToolbarActions()
+{
+    forkui::styleToolbarAction(darkTheme, darkThemeStyle, darkThemePaint);
+    forkui::styleToolbarAction(comics, comicsStyle, comicsPaint);
+}
+
+void Navigation::restoreForkToolbarActions()
+{
+    forkui::restoreToolbarAction(darkTheme, darkThemeStyle, darkThemePaint);
+    forkui::restoreToolbarAction(comics, comicsStyle, comicsPaint);
+}
+} // namespace kobalt::reader
