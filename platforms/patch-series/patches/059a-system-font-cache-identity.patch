index ec4cb732..1171f52d 100644
--- a/src/engine/blaze/crengine/src/lvfntman.cpp
+++ b/src/engine/blaze/crengine/src/lvfntman.cpp
@@ -7592,6 +7592,7 @@ class LVFreeTypeFontManager : public LVFontManager
 private:
     lString8    _fallbackFontFacesString;  // comma separated list of fallback fonts
     lString8Collection _fallbackFontFaces; // splitted from previous
+    std::vector<std::pair<lString8, lString8>> _fileIdentities;
     LVFontRegistry      _registry;         // physical face registry
     LVFontSelector      _font_selector;    // font matching/selection (see LVFontSelector)
     LVFontInstanceCache _instance_cache;   // exact-match instance cache
@@ -7619,6 +7620,17 @@ private:
     LVMutex   _lock;
 public:
 
+    void SetFontFileIdentity(lString8 path, lString8 identity) override {
+        FONT_MAN_GUARD
+        for (auto &entry : _fileIdentities) {
+            if (entry.first == path) {
+                entry.second = identity;
+                return;
+            }
+        }
+        _fileIdentities.emplace_back(path, identity);
+    }
+
     /// get hash of installed fonts and fallback font
     lUInt32 GetFontListHash(int documentId) override {
         FONT_MAN_GUARD
@@ -7633,7 +7645,16 @@ public:
                 // Include global faces and faces belonging to this document.
                 if (documentId != -1 && face.documentId != -1 && face.documentId != documentId)
                     continue;
-                lUInt32 h = face.file_path.getHash();
+                // Only explicitly identified host copies use content identity.
+                // Embedded, bundled and arbitrary external paths keep their semantics.
+                lString8 identity = face.file_path;
+                for (const auto &entry : _fileIdentities) {
+                    if (entry.first == face.file_path) {
+                        identity = entry.second;
+                        break;
+                    }
+                }
+                lUInt32 h = identity.getHash();
                 h = h * 31 + (lUInt32)face.face_index;
                 h = h * 31 + face.typeface.getHash(); // family name: changes if a face is moved to another family
                 h = h * 31 + (lUInt32)(unsigned)(int)face._wght_min;
