diff --git a/src/engine/blaze/adapter/engine_document.cpp b/src/engine/blaze/adapter/engine_document.cpp
index c9e8d9d9..d23f58e3 100644
--- a/src/engine/blaze/adapter/engine_document.cpp
+++ b/src/engine/blaze/adapter/engine_document.cpp
@@ -205,6 +205,26 @@ bool EngineDocument::initializeFonts()
                 ShutdownFontManager();
                 return false;
             }
+    // Firmware copies live under a new private directory on every launch.
+    // Hash their actual decoded bytes, never the random pathname or a basename.
+    // Restrict this to registered systemFiles: other font sources retain their
+    // existing cache identity and document-font scoping.
+    for (const auto &font : readingFonts) {
+        for (const auto &path : font.files) {
+            if (!fonts_.sources.systemFiles.contains(path))
+                continue;
+            QFile file(path);
+            QCryptographicHash hash(QCryptographicHash::Sha256);
+            if (!file.open(QIODevice::ReadOnly) || !hash.addData(&file)) {
+                readingFonts.clear();
+                ShutdownFontManager();
+                return false;
+            }
+            const auto identity = QByteArray("kobalt-system-sha256:") + hash.result().toHex();
+            fontMan->SetFontFileIdentity(lString8(path.toUtf8().constData()),
+                                        lString8(identity.constData()));
+        }
+    }
     // The generic monospace family for code, also under a chosen reading font,
     // and fallback faces for characters that a reading font lacks. The picker
     // offers script fallbacks when they match the document language.
