diff --git a/src/reading/locale_font_roles.h b/src/reading/locale_font_roles.h
new file mode 100644
index 00000000..903d737d
--- /dev/null
+++ b/src/reading/locale_font_roles.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "support/strings.h"
+#include <QString>
+#include <QStringList>
+
+namespace kobalt {
+inline bool russianFontRoles() { return strings::locale() == strings::Locale::Russian; }
+inline const char *localeDefaultFontFace() { return russianFontRoles() ? "Literata" : "Libron"; }
+inline const char *localePublisherSansFontFace() { return russianFontRoles() ? "Noto Serif" : "NV Legible Next"; }
+inline const char *localeBookishFontFace() { return russianFontRoles() ? "Lora" : "NV Ancizar Serif"; }
+// Migrate the replaced built-in roles, not unrelated custom typefaces.
+inline QString localeReadingFamily(QString family)
+{
+    if (!russianFontRoles()) return family;
+    if (family == "Libron" || family == "KF Libron") return "Literata";
+    if (family == "NV Legible Next" || family == "KF Legible Next") return "Noto Serif";
+    if (family == "NV Ancizar Serif" || family == "KF Ancizar Serif") return "Lora";
+    return family;
+}
+inline bool hiddenRussianReadingFamily(QString family)
+{
+    if (!russianFontRoles()) return false;
+    if (family.startsWith("NV ") || family.startsWith("KF ")) family = family.mid(3);
+    return QStringList{"Adelph", "Aleo", "Andada", "Basker", "Castoro", "Yrsa"}.contains(family);
+}
+} // namespace kobalt
