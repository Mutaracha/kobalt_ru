+}
diff --git a/tests/model/fb2_engine.cpp b/tests/model/fb2_engine.cpp
new file mode 100644
index 00000000..745f9bac
--- /dev/null
+++ b/tests/model/fb2_engine.cpp
@@ -0,0 +1,352 @@
+// Covers raw FB2 engine loading, resources, EPUB reuse, reflow, preview and cache lifecycle.
+#include "book_fixtures.h"
+#include "check.h"
+#include "render/page_content.h"
+#include "reader_inputs.h"
+#include "engine/blaze/adapter/engine_document.h"
+#include "publication/local_resources.h"
+#include "publication/publication.h"
+#include "support/qt_compat.h"
+#include <QGuiApplication>
+#include <QFile>
+#include <QTemporaryDir>
+#include <QDir>
+#include <QJsonDocument>
+
+using namespace kobalt;
+namespace {
+constexpr auto fb2Namespace = "http://www.gribuser.ru/xml/fictionbook/2.0";
+constexpr auto coverPngBase64 =
+    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==";
+QByteArray utf8FictionBook() {
+    QByteArray book;
+    book += "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n";
+    book += "<FictionBook xmlns=\"" + QByteArray(fb2Namespace) + "\">\n";
+    book += "<description><title-info>";
+    book += "<genre>science_fiction</genre>";
+    book += "<book-title>Russian Test Book</book-title>";
+    book += "<author><first-name>Test</first-name><last-name>Author</last-name></author>";
+    book += "<lang>ru</lang>";
+    book += "<coverpage><image href=\"#cover.png\"/></coverpage>";
+    book += "</title-info>";
+    book += "<document-info><id>test-document-id</id></document-info>";
+    book += "</description>\n<body>\n";
+    book += "<section id=\"ch1\"><title><p>Chapter One</p></title>";
+    book += "<epigraph><p>Epigraph text</p></epigraph>";
+    book += "<p>Regular paragraph with a note reference <a l:href=\"#n1\" type=\"note\">[1]</a> and following words.</p>";
+    book += "<poem><stanza><v>Line one</v><v>Line two</v></stanza></poem>";
+    book += "<table><tr><td><p>Table cell</p></td></tr></table>";
+    for (int i = 0; i < 12; ++i)
+        book += "<p>Filler paragraph " + QByteArray::number(i) + " with enough words to fill a screen.</p>";
+    book += "</section>\n";
+    book += "<section id=\"ch2\"><title><p>Chapter Two</p></title><p>Second chapter text.</p></section>";
+    book += "</body>\n<body name=\"notes\">";
+    book += "<section id=\"n1\"><title><p>1</p></title>";
+    book += "<p>First <strong>note</strong> paragraph.</p><p>Second note paragraph.</p>";
+    book += "</section></body>\n";
+    book += "<binary id=\"cover.png\" content-type=\"image/png\">" + QByteArray(coverPngBase64) + "</binary>";
+    book += "</FictionBook>";
+    return book;
+}
+
+QByteArray windows1251FictionBook() {
+    QByteArray book;
+    book += "<?xml version=\"1.0\" encoding=\"windows-1251\"?>\r\n";
+    book += "<FictionBook xmlns=\"" + QByteArray(fb2Namespace) + "\">";
+    book += "<description><title-info><book-title>";
+    book += QByteArray::fromHex("d2e5f1f2"); // Тест
+    book += "</book-title><author><last-name>";
+    book += QByteArray::fromHex("d2e5f1f2"); // Тест
+    book += "</last-name></author><lang>ru</lang></title-info></description>";
+    book += "<body><section><p>";
+    book += QByteArray::fromHex("cff0e8e2e5f22c20ece8f021"); // Привет, мир!
+    book += "</p></section></body></FictionBook>";
+    return book;
+}
+
+
+void engineAndResources()
+{
+    const auto bytes = utf8FictionBook();
+    QString error;
+    EngineDocument document(test::readerFonts());
+    require(!EngineDocument::supportedArchive(bytes, &error), "Raw FB2 passed the EPUB archive gate");
+    error.clear();
+    require(document.open(bytes, {600, 800}, {{"koblaze_first_spine_item", 2},
+                                           {"koblaze_last_spine_item", 3}}, &error), qPrintable(error));
+    require(document.pages() > 0 && document.embeddedFontCount() == 0, "FB2 pages/fonts");
+    require(document.title().contains("Russian Test Book") && !document.author().isEmpty(), "FB2 metadata");
+    require(document.chapters().size() >= 2, "FB2 section TOC");
+    require(!document.coverImage({120, 180}).isNull(), "FB2 binary cover");
+    require(!document.pageExcerpt(0).contains("science_fiction"), "FB2 metadata leaked into text");
+    const auto found = document.searchText("Filler paragraph 0", {}, 10);
+    require(!found.hits.isEmpty() && document.goTo(found.hits.first().start), "Cannot select FB2 body anchor");
+    const auto anchor = document.position();
+    require(document.setChapterMode(true, appearance::Patch({{"font_pixels", 34}}), {800, 600}),
+            "FB2 whole-document reflow failed");
+    require(document.fontSize() == 34 && document.position() == anchor, "FB2 reflow lost state");
+    require(!document.continuesBefore() && !document.continuesAfter()
+                    && document.roughPages().pages == 0, "FB2 acquired an EPUB chapter window");
+    {
+        EngineDocument preview(test::readerFonts());
+        require(preview.openPreview(document, {600, 800}, &error), qPrintable(error));
+        require(preview.pages() > 0 && !preview.image(preview.page()).isNull(), "FB2 preview is blank");
+        require(document.position() == anchor, "FB2 preview changed source position");
+        const auto previewAnchor = preview.position();
+        for (int cycle = 0; cycle < 3; ++cycle) {
+            for (bool comics : {true, false}) {
+                require(preview.applyAppearance(appearance::Patch(QJsonObject{
+                            {appearance::comicsModeKey, comics}, {"margin_pixels", 18},
+                            {"top_margin_pixels", 12}, {"bottom_margin_pixels", 12}}),
+                            QSize(600, comics ? 800 : 760)), "FB2 preview comics toggle");
+                const auto frame = preview.image(preview.page());
+                const auto layoutPreview = preview.imageFromAnchor(true);
+                require(!frame.isNull() && !pageNeedsTextSample(frame), "FB2 preview frame lost text");
+                require(!layoutPreview.isNull() && !pageNeedsTextSample(layoutPreview),
+                        qPrintable(QString("FB2 draft Layout preview blank after comics=%1 cycle=%2")
+                                   .arg(comics).arg(cycle)));
+                require(preview.position() == previewAnchor && document.position() == anchor,
+                        "FB2 preview comics toggle moved source or draft anchor");
+            }
+        }
+
+    }
+    QTemporaryDir root;
+    require(root.isValid(), "temporary directory");
+    const auto path = root.filePath("source.fb2");
+    QFile file(path);
+    require(file.open(QIODevice::WriteOnly) && file.write(bytes) == bytes.size(), "write FB2");
+    file.close();
+    Publication publication;
+    require(publication.inspect(bytes, &error), qPrintable(error));
+    {
+        auto cache = localResourceFactory(path, std::make_shared<SourceLease>())(
+                publication.sizes(), {}, std::make_shared<std::atomic_bool>(false));
+        EngineDocument streamed(test::readerFonts());
+        require(streamed.openResources(cache, publication.sizes(), {600, 800}, {}, &error), qPrintable(error));
+        require(streamed.title() == document.title() && streamed.pages() > 0, "Resource-backed FB2 load");
+    }
+    require(test::writeBook(root.path(), "control.epub", test::songbook(3)), "write control EPUB");
+    QFile epub(root.filePath("control.epub"));
+    require(epub.open(QIODevice::ReadOnly), "read control EPUB");
+    const auto epubBytes = epub.readAll();
+    require(document.open(epubBytes, {600, 800}, {}, &error), qPrintable(error));
+    require(document.title() == "Large songbook" && document.pages() > 0, "EPUB after FB2 inherited its stylesheet/state");
+    require(document.open(windows1251FictionBook(), {600, 800}, {}, &error), qPrintable(error));
+    require(document.title() == QString::fromUtf8("Тест"), "FB2 windows-1251 metadata");
+    require(!document.pageExcerpt(0).contains(QChar::ReplacementCharacter), "FB2 windows-1251 text");
+    require(document.open(epubBytes, {600, 800}, {}, &error), qPrintable(error));
+    require(document.title() == "Large songbook", "EPUB after reused FB2 source");
+}
+
+void cachedFictionBook()
+{
+    QTemporaryDir root;
+    require(root.isValid(), "cache temporary directory");
+    auto bytes = utf8FictionBook();
+    // ParseDocument deliberately skips cache lookup for sources <= 64 KiB
+    // (DOCUMENT_CACHING_MIN_SIZE). Pad XML, not rendered text, to test reuse
+    // without changing that upstream policy or making layout expensive.
+    bytes.replace("</FictionBook>", QByteArray("<!--") + QByteArray(128 * 1024, 'x')
+                  + "--></FictionBook>");
+    require(bytes.size() > 64 * 1024, "cache fixture must cross lookup threshold");
+    const auto cachePath = root.filePath("cache");
+    const auto configure = [&](EngineDocument &document) {
+        document.setDocumentCache(cachePath, QByteArray(64, 'c'), "fb2-engine-test", bytes.size());
+    };
+    QString error;
+    {
+        EngineDocument document(test::readerFonts());
+        configure(document);
+        require(document.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+        require(document.saveDocumentCache(), "Cannot save raw FB2 parsed cache");
+    }
+    {
+        EngineDocument document(test::readerFonts());
+        configure(document);
+        require(document.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+        require(document.openedFromCache() && document.pages() > 0, "FB2 parsed cache was not reused");
+        require(document.saveDocumentCacheStep(5), "Clean FB2 cache step did not complete");
+        require(document.removeDocumentCache(false), "Cannot remove FB2 book cache");
+    }
+    {
+        EngineDocument document(test::readerFonts());
+        configure(document);
+        require(document.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+        require(!document.openedFromCache(), "FB2 cache eviction left the mapped book available");
+    }
+}
+void coldPrefixExperiment()
+{
+    qputenv("KOBALT_FB2_HYBRID", "1");
+    qputenv("KOBALT_CHAPTER_PAGES", "2");
+    auto bytes = utf8FictionBook();
+    QByteArray paragraphs;
+    for (int i = 0; i < 1200; ++i)
+        paragraphs += "<p>Cold prefix paragraph " + QByteArray::number(i)
+                + " contains words for a long native FictionBook layout test. More words here.</p>";
+    bytes.replace("</section>\n", paragraphs + "</section>\n");
+    bytes.replace("<body>", "<body name='MAIN'>");
+    QString error;
+    EngineDocument accurate(test::readerFonts());
+    require(accurate.open(bytes, {600, 800}, {{"koblaze_first_spine_item", -1}}, &error), qPrintable(error));
+    QTemporaryDir cacheRoot;
+    require(cacheRoot.isValid(), "prefix cache directory");
+    const auto configureCache = [&](EngineDocument &document) {
+        document.setDocumentCache(cacheRoot.filePath("parsed"), QByteArray(64, 'd'),
+                                  "fb2-prefix-test", bytes.size());
+    };
+    EngineDocument prefix(test::readerFonts());
+    configureCache(prefix);
+    require(prefix.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+    require(prefix.partOfBook(), "FB2 cold prefix not active");
+    require(prefix.continuesAfter(), "FB2 prefix did not retain continuation");
+    require(prefix.wholeBookPageCount() == 0 && prefix.pages() < accurate.pages(), "prefix claimed full pages");
+    require(!prefix.image(0).isNull() && prefix.image(0) == accurate.image(0), "prefix first frame differs from full");
+    require(!prefix.saveDocumentCache(), "prefix allowed full-book cache save");
+    const auto anchor = prefix.position();
+    const auto prefixFrame = prefix.image(prefix.page());
+    require(prefix.prepareFullDocument([] { return false; }) == Engine::FullDocument::Stopped,
+            "cancelled FB2 full build unexpectedly completed");
+    require(prefix.partOfBook() && prefix.position() == anchor
+                    && prefix.image(prefix.page()) == prefixFrame
+                    && prefix.wholeBookPageCount() == 0,
+            "pre-start cancellation damaged readable FB2 prefix");
+    int checks = 0;
+    require(prefix.prepareFullDocument([&] { return ++checks <= 5; }) == Engine::FullDocument::Stopped,
+            "FB2 background build did not park at bounded stop checks");
+    require(prefix.partOfBook() && prefix.position() == anchor
+                    && prefix.image(prefix.page()) == prefixFrame
+                    && !prefix.saveDocumentCache(),
+            "parked FB2 build replaced prefix or saved incomplete layout");
+    auto current = [] { return true; };
+    require(prefix.prepareFullDocument(current) == Engine::FullDocument::Ready, "FB2 full build failed");
+    require(prefix.wholeBookPageCount() == accurate.pages(), "background full count mismatch");
+    require(prefix.saveDocumentCache(), "completed FB2 full build not saved through prefix");
+    {
+        EngineDocument warm(test::readerFonts());
+        configureCache(warm);
+        require(warm.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+        require(warm.openedFromCache() && !warm.partOfBook() && warm.pages() == accurate.pages(),
+                "warm FB2 lost full cache or entered prefix");
+    }
+    require(prefix.setChapterMode(false, appearance::Patch(), {600, 800}), "FB2 full adoption failed");
+    require(!prefix.partOfBook() && prefix.position() == anchor, "FB2 adoption lost native anchor");
+    EngineDocument jump(test::readerFonts());
+    require(jump.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+    accurate.go(accurate.pages() - 2);
+    const auto distant = accurate.position();
+    require(jump.goTo(distant) && !jump.partOfBook() && jump.position() == distant,
+            "jump beyond prefix did not safely promote");
+    EngineDocument resumed(test::readerFonts());
+    require(resumed.open(bytes, {600, 800}, {{"position", distant}}, &error), qPrintable(error));
+    require(!resumed.partOfBook() && resumed.position() == distant, "saved FB2 position used prefix");
+    EngineDocument fraction(test::readerFonts());
+    require(fraction.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+    const auto firstFractionImage = fraction.image(0);
+    require(fraction.go(1), "advance inside prefix before restart");
+    require(fraction.goToFraction(0) && fraction.partOfBook() && fraction.page() == 0
+                    && fraction.image(0) == firstFractionImage && !fraction.fullDocumentStarted(),
+            "restart at zero promoted the FB2 prefix");
+    require(fraction.goToFraction(-1) && fraction.partOfBook(), "negative fraction did not clamp to prefix start");
+    require(fraction.goToFraction(0.9) && !fraction.partOfBook(), "fraction jump stayed in prefix");
+    // Destroy a prefix with a parked full build. Reopening independently must
+    // remain usable and must not find a partial full-book cache from that build.
+    QTemporaryDir closingCache;
+    require(closingCache.isValid(), "parked close cache directory");
+    {
+        EngineDocument closing(test::readerFonts());
+        closing.setDocumentCache(closingCache.path(), QByteArray(64, 'e'),
+                                 "fb2-parked-close", bytes.size());
+        require(closing.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+        int seen = 0;
+        require(closing.prepareFullDocument([&] { return ++seen <= 5; })
+                        == Engine::FullDocument::Stopped,
+                "FB2 full build did not park before destruction");
+    }
+    {
+        EngineDocument afterClose(test::readerFonts());
+        afterClose.setDocumentCache(closingCache.path(), QByteArray(64, 'e'),
+                                    "fb2-parked-close", bytes.size());
+        require(afterClose.open(bytes, {600, 800}, {}, &error), qPrintable(error));
+        require(!afterClose.openedFromCache() && afterClose.partOfBook()
+                        && afterClose.wholeBookPageCount() == 0,
+                "closed parked build left a reusable partial full-book cache");
+        require(afterClose.prepareFullDocument({}) == Engine::FullDocument::Ready
+                        && afterClose.wholeBookPageCount() == accurate.pages(),
+                "independent FB2 build failed after parked predecessor destruction");
+    }
+    qunsetenv("KOBALT_CHAPTER_PAGES");
+    qunsetenv("KOBALT_FB2_HYBRID");
+}
+
+// Compare rendered output against an independently opened full document, not
+// merely the presence of a binary cover or a non-empty search result.
+void prefixNotesAndBodyImages()
+{
+    qputenv("KOBALT_FB2_HYBRID", "1");
+    qputenv("KOBALT_CHAPTER_PAGES", "2");
+    auto bytes = utf8FictionBook();
+    bytes.replace("<FictionBook xmlns=", "<FictionBook xmlns:l='http://www.w3.org/1999/xlink' xmlns=");
+    bytes.replace("<epigraph>", "<image l:href='#cover.png'/><epigraph>");
+    QByteArray tail;
+    for (int n = 0; n < 1200; ++n)
+        tail += "<p>Resource parity filler " + QByteArray::number(n)
+                + " with sufficient text to require a native startup prefix.</p>";
+    tail += "<p>LateBodyImageMarker</p><image l:href='#cover.png'/>";
+    bytes.replace("</section>\n", tail + "</section>\n");
+    for (bool inpage : {false, true}) {
+        const QJsonObject settings{{"inpage_footnotes", inpage}};
+        auto fullSettings = settings;
+        fullSettings["koblaze_first_spine_item"] = -1;
+        QString error;
+        EngineDocument full(test::readerFonts());
+        require(full.open(bytes, {600, 800}, fullSettings, &error), qPrintable(error));
+        EngineDocument prefix(test::readerFonts());
+        require(prefix.open(bytes, {600, 800}, settings, &error), qPrintable(error));
+        // A conservative full fallback is permitted when note layout cannot
+        // safely be represented as a prefix. Either path must match Accurate.
+        require(prefix.image(0) == full.image(0), "FB2 note/image first frame differs");
+        if (prefix.partOfBook()) {
+            require(prefix.wholeBookPageCount() == 0, "note/image prefix claimed final count");
+            require(prefix.prepareFullDocument({}) == Engine::FullDocument::Ready,
+                    "note/image full build failed");
+            require(prefix.setChapterMode(false, appearance::Patch(), {600, 800}),
+                    "note/image full adoption failed");
+        }
+        require(!prefix.partOfBook() && prefix.pages() == full.pages(),
+                "note/image full count differs from Accurate");
+        require(prefix.coverImage({120, 180}) == full.coverImage({120, 180})
+                        && !prefix.coverImage({120, 180}).isNull(),
+                "binary image resource lost during note/image handoff");
+        for (const auto *text : {"Regular paragraph with a note reference", "First", "LateBodyImageMarker"}) {
+            SearchBatch found;
+            int batches = 0;
+            do {
+                found = full.searchText(text, found.cursor, 10);
+                require(++batches < 10000, "bounded reference search did not finish");
+            } while (found.hits.isEmpty() && !found.done);
+            require(!found.hits.isEmpty(), qPrintable(QString("reference passage missing: %1 (inpage=%2)").arg(text).arg(inpage)));
+            const auto anchor = found.hits.first().start;
+            require(full.goTo(anchor) && prefix.goTo(anchor), "note/image anchor cannot be resolved");
+            require(prefix.position() == full.position()
+                            && prefix.image(prefix.page()) == full.image(full.page()),
+                    "note/image rendered passage differs after full adoption");
+        }
+    }
+    qunsetenv("KOBALT_CHAPTER_PAGES");
+    qunsetenv("KOBALT_FB2_HYBRID");
+}
+
+}
+int main(int argc, char **argv)
+{
+    QGuiApplication app(argc, argv);
+    setChapterModeOverride(1);
+    engineAndResources();
+    cachedFictionBook();
+    coldPrefixExperiment();
+    prefixNotesAndBodyImages();
+    setChapterModeOverride(-1);
+    std::puts("PASS: FB2 engine sources, metadata, cover, encoding, preview, EPUB reuse and parsed cache");
+}
