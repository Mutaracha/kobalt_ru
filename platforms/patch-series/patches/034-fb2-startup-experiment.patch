+namespace kobalt {
+ldomNode *EngineDocument::fb2MainBody() const
+{
+    if (!fb2Document_ || !engine_) return nullptr;
+    // Require exactly one ordinary body; notes/comments may follow it.
+    ldomNode *result = nullptr;
+    QVector<ldomNode *> pending{engine_->getDocument()->getRootNode()};
+    while (!pending.isEmpty()) {
+        auto *node = pending.takeLast();
+        if (!node || !node->isElement()) continue;
+        if (node->isNodeName("body") && node->getParentNode()
+                && node->getParentNode()->isNodeName("FictionBook")) {
+            const auto name = node->getAttributeValue("name");
+            if (name != U"notes" && name != U"comments") {
+                if (result) return nullptr;
+                result = node;
+            }
+            continue;
+        }
+        for (int i = node->getChildCount() - 1; i >= 0; --i)
+            pending.append(node->getChildNode(i));
+    }
+    return result;
+}
+} // namespace kobalt
