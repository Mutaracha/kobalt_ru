+#pragma once
+#include <lvstream.h>
+#include <lvdocview.h>
+#include <QSet>
+#include <QString>
+class LVDocView;
+
+namespace kobalt {
+// Effective overlay only: never write these values back to saved appearance.
+struct ComicPageLayout
+{
+    int columns;
+    lvRect margins;
+};
+ComicPageLayout comicPageLayout(bool enabled, int baseColumns, lvRect baseMargins);
+// Fork-only effective styles. Applied after publisher/user CSS; never persisted.
+const char *comicPageCss();
+const char *comicSpreadCss();
+// Explicit OPF center placement takes precedence over bitmap aspect ratio.
+QSet<QString> singleComicPages(const LVContainerRef &container);
+void markComicImages(LVDocView *view);
+} // namespace kobalt
diff --git a/tests/model/comics_layout.cpp b/tests/model/comics_layout.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..331b0368dcdfcdaccbfba5ce66040ee8c10b8404
--- /dev/null
+++ b/tests/model/comics_layout.cpp
@@ -0,0 +1,84 @@
+// First comics layer: effective geometry and bounded OPF center-page metadata.
+#include "check.h"
+#include "book_fixtures.h"
+#include "engine/blaze/adapter/reader_comics.h"
+#include "engine/blaze/adapter/column_view.h"
+#include "reader_inputs.h"
+#include "engine/blaze/adapter/engine_document.h"
+#include <QGuiApplication>
+#include <QFile>
+#include <QTemporaryDir>
+#include <cstdio>
+
+using namespace kobalt;
+namespace {
+QSet<QString> centeredPages(const QByteArray &package, const QByteArray &descriptor =
+        "<container><rootfiles><rootfile full-path='OPS/book.opf'/></rootfiles></container>")
+{
+    QTemporaryDir root;
+    require(root.isValid(), "OPF test directory");
+    const QMap<QString, QByteArray> files{
+        {"mimetype", "application/epub+zip"},
+        {"META-INF/container.xml", descriptor}, {"OPS/book.opf", package}
+    };
+    require(test::writeBook(root.path(), "metadata.epub", files), "write OPF fixture");
+    QFile file(root.filePath("metadata.epub"));
+    require(file.open(QIODevice::ReadOnly), "read OPF fixture");
+    auto bytes = file.readAll();
+    auto stream = LVCreateMemoryStream(bytes.data(), bytes.size(), false, LVOM_READ);
+    const auto container = LVOpenArchieve(stream);
+    require(!container.isNull(), "metadata archive");
+    return singleComicPages(container);
+}
+}
+
+int main(int argc, char **argv)
+{
+    QGuiApplication app(argc, argv);
+    EngineDocument fonts(test::readerFonts());
+    require(fonts.initializeFonts(), "reading fonts");
+    const lvRect base(11, 22, 11, 33);
+    for (int columns : {0, 1, 2, 3}) {
+        const auto off = comicPageLayout(false, columns, base);
+        require(off.columns == columns && off.margins.left == 11 && off.margins.top == 22
+                        && off.margins.right == 11 && off.margins.bottom == 33,
+                "disabled overlay changed base layout");
+        const auto on = comicPageLayout(true, columns, base);
+        require(on.columns == 1 && on.margins.left == 0 && on.margins.top == 0
+                        && on.margins.right == 0 && on.margins.bottom == 0,
+                "comics overlay must use one marginless source column");
+    }
+    require(base.left == 11 && base.top == 22 && base.bottom == 33, "saved geometry mutated");
+    require(singleComicPages(LVContainerRef()).isEmpty(), "null container");
+    const QByteArray package =
+        "<package><manifest>"
+        "<item id='center' href='Art/center%20page.xhtml'/>"
+        "<item id='normal' href='normal.xhtml'/></manifest><spine>"
+        "<itemref idref='center' properties='rendition:layout-pre-paginated  rendition:page-spread-center'/>"
+        "<itemref idref='normal' properties='page-spread-left'/>"
+        "<itemref idref='missing' properties='rendition:page-spread-center'/>"
+        "</spine></package>";
+    require(centeredPages(package) == QSet<QString>{"OPS/Art/center page.xhtml"},
+            "OPF center marker, relative path, percent decoding or ordinary page handling");
+    require(centeredPages("<package><spine><itemref properties='rendition:page-spread-center'").isEmpty(),
+            "malformed package must not invent center pages");
+    require(centeredPages(package, "<container/>").isEmpty(), "missing package path");
+    require(centeredPages(QByteArray(2 * 1024 * 1024 + 1, 'x')).isEmpty(), "package size bound");
+    require(!QByteArray(comicPageCss()).isEmpty() && !QByteArray(comicSpreadCss()).isEmpty(),
+            "comics styles missing");
+    markComicImages(nullptr);
+    // New spread state is opt-in and must not alter the regular column path.
+    ColumnView view;
+    view.setColumns(1);
+    view.Resize(600, 800);
+    const auto pages = view.getPageCount();
+    view.setComicSpreads(false);
+    view.rebuildComicSpreads();
+    require(view.getPageCount() == pages && view.firstColumn(0) == 0,
+            "disabled comics changed ordinary column mapping");
+    view.setComicSpreads(true);
+    view.rebuildComicSpreads(); // portrait viewport: no spread state
+    require(view.getPageCount() == pages && view.comicPageCount(0) == 1,
+            "portrait viewport created a spread");
+    std::puts("PASS: comics layout overlay, bounded OPF center metadata and default column path");
+}
