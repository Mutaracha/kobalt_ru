diff --git a/src/engine/blaze/adapter/column_view_comics.cpp b/src/engine/blaze/adapter/column_view_comics.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2907e5ef1f61b16df729e5a34cce699b7133416
--- /dev/null
+++ b/src/engine/blaze/adapter/column_view_comics.cpp
@@ -0,0 +1,123 @@
+#include "column_view.h"
+#include <vector>
+
+namespace kobalt {
+// Fork-only spread classification and image geometry; shared column layout stays upstream.
+int ColumnView::comicPageCount(int page) const
+{
+    return page >= 0 && page < comicStarts.size()
+            ? (page + 1 < comicStarts.size() ? comicStarts[page + 1] : comicInternalPages)
+                    - comicStarts[page]
+            : 1;
+}
+
+ldomNode *ColumnView::rotatedComicNode(int page) const
+{
+    const int internal = firstPage(page);
+    return internal >= 0 && internal < comicCenters.size() ? comicCenters[internal] : nullptr;
+}
+
+ldomNode *ColumnView::singleComicNode(int page) const
+{
+    const int internal = firstPage(page);
+    return comicPageCount(page) == 1 && internal >= 0 && internal < comicImages.size()
+            ? comicImages[internal]
+            : nullptr;
+}
+
+QRect ColumnView::singleComicRect(int page) const
+{
+    auto *node = singleComicNode(page);
+    const auto source = node ? node->getObjectImageSource() : LVImageSourceRef();
+    if (source.isNull())
+        return { };
+    // A center marker does not imply rotation: only a portrait bitmap turns.
+    const bool rotate = rotatedComicNode(page) != nullptr;
+    const auto fitted = (rotate ? QSize(source->GetHeight(), source->GetWidth())
+                                : QSize(source->GetWidth(), source->GetHeight()))
+                                .scaled(QSize(!rotate && source->GetHeight() > source->GetWidth()
+                                                      ? viewportWidth / 2
+                                                      : viewportWidth,
+                                              viewportHeight),
+                                        Qt::KeepAspectRatio);
+    return QRect(
+            QPoint((viewportWidth - fitted.width()) / 2, (viewportHeight - fitted.height()) / 2),
+            fitted);
+}
+
+void ColumnView::setComicVerticalOffset(int page, int column, int offset, const QRect &bounds)
+{
+    const int internal = firstPage(page) + column;
+    if (internal >= 0 && internal < comicVerticalOffsets.size()) {
+        comicVerticalOffsets[internal] = offset;
+        comicImageRects[internal] = bounds;
+    }
+}
+
+void ColumnView::rebuildComicSpreads()
+{
+    comicStarts.clear();
+    comicCenters.clear();
+    comicImages.clear();
+    comicVerticalOffsets.clear();
+    comicImageRects.clear();
+    if (!comicSpreads || viewportWidth <= viewportHeight || columns != 1)
+        return;
+    comicInternalPages = LVDocView::getPageCount();
+    QVector<int> portraits(comicInternalPages, 0), images(comicInternalPages, 0);
+    comicCenters.fill(nullptr, comicInternalPages);
+    comicImages.fill(nullptr, comicInternalPages);
+    comicVerticalOffsets.fill(0, comicInternalPages);
+    comicImageRects.fill(QRect(), comicInternalPages);
+    std::vector<ldomNode *> pending{ getDocument()->getRootNode() };
+    while (!pending.empty()) {
+        auto *node = pending.back();
+        pending.pop_back();
+        if (!node || !node->isElement())
+            continue;
+        if (node->isNodeName("head") || node->isNodeName("style") || node->isNodeName("script"))
+            continue;
+        if (node->isNodeName("img") || node->isNodeName("image")) {
+            const int page = LVDocView::getBookmarkPage(ldomXPointer(node, 0), true);
+            if (page >= 0 && page < comicInternalPages) {
+                ++images[page];
+                bool centered = false, linked = false;
+                for (auto *parent = node; parent && !parent->isNodeName("DocFragment");
+                     parent = parent->getParentNode()) {
+                    centered |= parent->getAttributeValue("data-kobalt-comic-single") == U"1";
+                    linked |= parent->isNodeName("a");
+                }
+                if (!linked)
+                    comicImages[page] = node;
+                const auto source =
+                        centered && !linked ? node->getObjectImageSource() : LVImageSourceRef();
+                if (!source.isNull() && source->GetWidth() > 0
+                    && source->GetHeight() > source->GetWidth())
+                    comicCenters[page] = node;
+                if (node->getAttributeValue("data-kobalt-comic-portrait") == U"1")
+                    ++portraits[page];
+            }
+        }
+        for (int i = node->getChildCount() - 1; i >= 0; --i)
+            pending.push_back(node->getChildNode(i));
+    }
+    QVector<bool> pairable(comicInternalPages, false);
+    for (int page = 0; page < comicInternalPages; ++page) {
+        const auto text = LVDocView::getPageText(false, page);
+        const bool imageOnly = images[page] == 1
+                && QString::fromUtf8(UnicodeToUtf8(text).c_str()).trimmed().isEmpty();
+        pairable[page] = imageOnly && portraits[page] == 1;
+        if (!imageOnly) {
+            comicCenters[page] = nullptr;
+            comicImages[page] = nullptr;
+        }
+    }
+    for (int page = 0; page < comicInternalPages;) {
+        comicStarts.append(page);
+        page += pairable[page] && page + 1 < comicInternalPages && pairable[page + 1]
+                        && LVDocView::getPageFlow(page) == LVDocView::getPageFlow(page + 1)
+                ? 2
+                : 1;
+    }
+}
+} // namespace kobalt
diff --git a/src/engine/blaze/adapter/reader_comics.cpp b/src/engine/blaze/adapter/reader_comics.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..591d33acc74be5d313dfe86b060bb54d84f429c2
--- /dev/null
+++ b/src/engine/blaze/adapter/reader_comics.cpp
@@ -0,0 +1,122 @@
+#include "reader_comics.h"
+#include "support/qt_compat.h"
+#include <lvdocview.h>
+#include <lvimg.h>
+#include <QDir>
+#include <QHash>
+#include <QFileInfo>
+#include <QXmlStreamReader>
+#include <QRegularExpression>
+#include <QUrl>
+#include <vector>
+
+namespace kobalt {
+ComicPageLayout comicPageLayout(bool enabled, int baseColumns, lvRect baseMargins)
+{
+    return { enabled ? 1 : baseColumns, enabled ? lvRect(0, 0, 0, 0) : baseMargins };
+}
+
+const char *comicPageCss()
+{
+    return "\nhtml,body,DocFragment,div,p,section { margin:0 !important; padding:0 !important; "
+           "text-indent:0 !important; }\n"
+           "body[data-kobalt-leading-image=\"1\"] { padding-top:0 !important; }\n"
+           "img { display:block !important; width:auto !important; height:auto !important; "
+           "max-width:100% !important; max-height:100vh !important; margin:0 auto !important; "
+           "padding:0 !important; page-break-inside:avoid !important; page-break-after:always !important; }\n";
+}
+
+const char *comicSpreadCss()
+{
+    return "img[data-kobalt-comic-portrait=\"1\"], image[data-kobalt-comic-portrait=\"1\"] "
+           "{ max-width:50vw !important; }\n";
+}
+
+QSet<QString> singleComicPages(const LVContainerRef &container)
+{
+    QSet<QString> result;
+    if (container.isNull())
+        return result;
+    const auto read = [&container](const QString &path) {
+        auto stream =
+                container->OpenStream(Utf8ToUnicode(path.toUtf8().constData()).c_str(), LVOM_READ);
+        // Package metadata is bounded, just like the chapter sanitizer.
+        if (stream.isNull() || stream->GetSize() > 2 * 1024 * 1024)
+            return QByteArray();
+        QByteArray bytes(int(stream->GetSize()), '\0');
+        lvsize_t count = 0;
+        return stream->Read(bytes.data(), bytes.size(), &count) == LVERR_OK
+                        && count == lvsize_t(bytes.size())
+                ? bytes
+                : QByteArray();
+    };
+    QXmlStreamReader descriptor(read(QStringLiteral("META-INF/container.xml")));
+    QString package;
+    while (!descriptor.atEnd()) {
+        if (descriptor.readNext() == QXmlStreamReader::StartElement
+            && descriptor.name() == QLatin1String("rootfile")) {
+            package = descriptor.attributes().value("full-path").toString();
+            break;
+        }
+    }
+    if (package.isEmpty())
+        return result;
+    QXmlStreamReader xml(read(package));
+    QHash<QString, QString> manifest;
+    QSet<QString> centered;
+    const QRegularExpression whitespace(QStringLiteral("\\s+"));
+    while (!xml.atEnd()) {
+        if (xml.readNext() != QXmlStreamReader::StartElement)
+            continue;
+        const auto attributes = xml.attributes();
+        if (xml.name() == QLatin1String("item")) {
+            manifest.insert(attributes.value("id").toString(), attributes.value("href").toString());
+        } else if (xml.name() == QLatin1String("itemref")) {
+            const auto properties =
+                    attributes.value("properties").toString().split(whitespace, qt::skipEmptyParts);
+            if (properties.contains(QStringLiteral("rendition:page-spread-center")))
+                centered.insert(attributes.value("idref").toString());
+        }
+    }
+    if (xml.hasError())
+        return result;
+    for (const auto &id : centered) {
+        const auto href = manifest.value(id);
+        if (!href.isEmpty())
+            result.insert(QDir::cleanPath(QFileInfo(package).path() + '/'
+                                          + QUrl::fromPercentEncoding(href.toUtf8())));
+    }
+    return result;
+}
+
+// Classify the original bitmap, never its viewport-dependent rendered rectangle.
+// No rotation is performed. Unknown images conservatively remain full-width.
+void markComicImages(LVDocView *view)
+{
+    if (!view || !view->getDocument())
+        return;
+    auto *document = view->getDocument();
+    const auto attribute = document->getAttrNameIndex("data-kobalt-comic-portrait");
+    std::vector<ldomNode *> pending{ document->getRootNode() };
+    while (!pending.empty()) {
+        auto *node = pending.back();
+        pending.pop_back();
+        if (!node || !node->isElement())
+            continue;
+        if (node->isNodeName("img") || node->isNodeName("image")) {
+            const auto image = node->getObjectImageSource();
+            bool standalone = false;
+            for (auto *parent = node; parent && !parent->isNodeName("DocFragment");
+                 parent = parent->getParentNode())
+                standalone |= parent->getAttributeValue("data-kobalt-comic-single") == U"1";
+            const bool portrait = !standalone && !image.isNull() && image->GetWidth() > 0
+                    && image->GetHeight() > image->GetWidth();
+            node->setAttributeValue(0, attribute, portrait ? U"1" : U"0");
+        }
+        for (int i = node->getChildCount() - 1; i >= 0; --i)
+            pending.push_back(node->getChildNode(i));
+    }
+    document->forceReinitStyles();
+}
+
+} // namespace kobalt
