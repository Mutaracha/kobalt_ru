+#include <cstdio>
+
+using namespace kobalt;
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    ReadingPage page(nullptr, [] {});
+    page.resize(800, 600);
+    page.setPalette(ui::readerPalette(page.palette(), false));
+    page.chrome = headerfooter::presetLayout(headerfooter::Preset::Default);
+    page.chrome.headerEnabled = true;
+    page.chrome.footerEnabled = true;
+    page.chrome.progressBar = true;
+    const auto savedChrome = page.chrome;
+    page.comicsMode = true;
+    page.refreshContent();
+    require(page.topHeight() == 0 && page.bottomHeight() == 0
+                    && page.headerImage().isNull() && page.footerImage().isNull(),
+            "comics retained reading chrome or margins");
+    require(page.property("kobalt_graphics_refresh").toBool(), "graphics refresh property missing");
+    // A draft can turn off comics before the applied page is repainted.
+    page.comicsMode = false;
+    require(!page.headerImage().isNull() && !page.footerImage().isNull(),
+            "draft preview reused stale hidden chrome");
