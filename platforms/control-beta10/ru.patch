diff --git a/src/support/string_locale.h b/src/support/string_locale.h
new file mode 100644
index 00000000..c775f4c9
--- /dev/null
+++ b/src/support/string_locale.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "string_table.h"
+#include <QLocale>
+#include <atomic>
+
+namespace kobalt::strings {
+enum class Locale { English, Russian };
+
+namespace detail {
+inline const Entry *russianTable(int *count)
+{
+    static const Entry values[] = {
+#include <kobalt_strings_ru.inc>
+    };
+    *count = int(sizeof(values) / sizeof(values[0]));
+    return values;
+}
+} // namespace detail
+
+inline std::atomic_int &localeStore()
+{
+    static std::atomic_int value(int(Locale::Russian));
+    return value;
+}
+
+inline void setLocale(Locale locale)
+{
+    localeStore().store(int(locale));
+}
+
+inline Locale locale()
+{
+    return Locale(localeStore().load());
+}
+
+// Dates and grouped figures follow the selected UI language rather than the
+// process locale configured by the host.
+inline const QLocale &formatLocale()
+{
+    static const QLocale english(QLocale::English, QLocale::UnitedStates);
+    static const QLocale russian(QLocale::Russian, QLocale::Russia);
+    return locale() == Locale::Russian ? russian : english;
+}
+
+} // namespace kobalt::strings
