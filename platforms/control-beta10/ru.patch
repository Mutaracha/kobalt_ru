+#pragma once
+#include "fonts.h"
+#include "private_text.h"
+#include "support/strings.h"
+#include <QRect>
+
+namespace kobalt::ui {
+// The shared cap-height anchor must not become the clipping box for Cyrillic
+// accents/descenders. Keep the Latin baseline; allow the label's actual ink.
+inline QRect localeLabelInkRect(QRect capArea, const QString &text, const QFont &font)
+{
+    if (strings::locale() != strings::Locale::Russian || text.isEmpty())
+        return capArea;
+    const auto reference = interfaceInkBounds(QStringLiteral("H"), font);
+    const auto ink = interfaceInkBounds(text, font);
+    capArea.translate(0, ink.top() - reference.top());
+    capArea.setHeight(ink.height());
+    return capArea;
+}
+
+// Corsiva figures are optically larger than Instrument Serif at the same em.
+// Apply only to statistics, never globally to titles, metadata or book text.
+inline int localeStatisticPixels(int pixels)
+{
+    return strings::locale() == strings::Locale::Russian ? qMax(1, qRound(pixels * .8)) : pixels;
+}
+
+inline QFont statisticFont(int pixels)
+{
+    return brandFont(localeStatisticPixels(pixels));
+}
+
+// Restore the bounded single-line fitting used by the Russian sleep designs.
+// Measure with the renderer that will paint, not QFontMetrics from a fallback.
+inline QFont fittedLocaleFont(QFont font, const QString &text, int width, int height)
+{
+    if (strings::locale() != strings::Locale::Russian)
+        return font;
+    const int minimum = qMax(1, font.pixelSize() / 2);
+    while (font.pixelSize() > minimum
+           && (interfaceTextWidth(text, font) > qMax(1, width)
+               || interfaceLineHeight(font) > qMax(1, height)))
+        font.setPixelSize(font.pixelSize() - 1);
+    return font;
+}
+} // namespace kobalt::ui
