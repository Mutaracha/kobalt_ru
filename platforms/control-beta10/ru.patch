+
+using namespace kobalt;
+
+static int inkPixels(const QImage &image)
+{
+    int count = 0;
+    for (int y = 0; y < image.height(); ++y)
+        for (int x = 0; x < image.width(); ++x)
+            count += qGray(image.pixel(x, y)) < 200;
+    return count;
+}
+
+// Checks RU label rasters, sleep fitting, percent contracts, statistics and EN isolation.
+int main(int argc, char **argv)
+{
+    QApplication app(argc, argv);
+    const auto language = argc > 1 && QByteArray(argv[1]) == "en"
+            ? strings::Locale::English : strings::Locale::Russian;
+    strings::setLocale(language);
+    require(test::readerAssets().available(), "Control assets unavailable");
+    require(ui::initializeInterfaceFonts(test::readerAssets()), "Control fonts unavailable");
+    require(ui::brandFont(40).family() == (language == strings::Locale::Russian
+                    ? "Monotype Corsiva" : "Instrument Serif"), "Wrong locale serif family");
+    require(reader::themePreset("playful").mainFace == (language == strings::Locale::Russian
+                    ? "Caveat" : "Kalam"), "Wrong locale handwriting preset");
+    require(ui::localeStatisticPixels(100) == (language == strings::Locale::Russian ? 80 : 100),
+            "Statistics scale leaked across locales");
+
+    const char *percentKeys[] = { "common.percent", "chapter_graph.book_progress",
+        "chapter_graph.chapter_progress", "kosync.percent", "reader.brightness", "reader.warmth",
+        "header_footer.field_description.battery_warning", "sleep.percent_read",
+        "sleep.battery_charged", "sleep.percent_through" };
+    for (const auto *key : percentKeys) {
+        // Fill the book-title slot too: an unresolved %2 is not a percent sign.
+        const auto value = strings::get(key).replace(QStringLiteral("%2"), QStringLiteral("Book"))
+                .arg(strings::percentArgument(qint64(99)));
+        if (value.count('%') != 1)
+            std::fprintf(stderr, "Percent contract failed for %s: %s\n", key, qPrintable(value));
+        require(value.count('%') == 1, "Repeated/missing sign in a formatted percent argument");
+    }
+    require(strings::get("sleep.state_with_battery")
+                    .arg("Status", strings::percentArgument(qint64(99))).count('%') == 1,
+            "Repeated charging status percent");
+
+    const auto output = qEnvironmentVariable("KOBALT_RU_RENDER_DIR");
+    if (!output.isEmpty())
+        require(QDir().mkpath(output), "Cannot create review output directory");
+    for (const int ppi : { 212, 300 }) {
+        ui::setDensity(ppi);
+        const auto font = ui::interfaceFont(ui::metrics::chrome::tabText);
+        const int cap = ui::interfaceInkBounds("H", font).height();
+        for (const auto &text : { QString::fromUtf8("РАСКЛАДКА"), QString::fromUtf8("ОТЛАДКА"),
+                                 QString::fromUtf8("ГЛАВЫ"), QString::fromUtf8("СТАТИСТИКА") }) {
+            const QRect anchor(4, 60, 390, cap);
+            const auto bounds = ui::localeLabelInkRect(anchor, text, font);
+            if (language == strings::Locale::English)
+                require(bounds == anchor, "English cap-height geometry changed");
+            QImage actual(400, 160, QImage::Format_RGB32), reference(actual.size(), actual.format());
+            actual.fill(Qt::white);
+            reference.fill(Qt::white);
+            {
+                QPainter painter(&actual);
+                painter.setPen(Qt::black);
+                painter.setFont(font);
+                ui::drawOpticalText(painter, bounds, text, true);
+            }
+            {
+                QPainter painter(&reference);
+                painter.setPen(Qt::black);
+                painter.setFont(font);
+                ui::drawOpticalText(painter, QRect(4, 20, 390, 120), text, true);
+            }
+            if (language == strings::Locale::Russian)
+                require(inkPixels(actual) >= inkPixels(reference) * .98,
+                        "Cyrillic tab ink clipped against a full-height reference");
+        }
+        QFont large = ui::brandFont(80);
+        const QString time = QString::fromUtf8("1 ч 31 мин");
+        const auto fitted = ui::fittedLocaleFont(large, time, 240, 120);
+        if (language == strings::Locale::Russian)
+            require(ui::interfaceTextWidth(time, fitted) <= 240,
+                    "Russian widget time does not fit the test tile");
+        else
+            require(fitted.pixelSize() == large.pixelSize(), "English font was shrunk");
+        StatsCell cell(nullptr, "ruControl", strings::get("activity.reading"));
+        cell.resize(400, 240);
+        cell.ensurePolished();
+        cell.set("895", strings::get("stats.pages_left"), "10 ч 19 мин");
+        require(cell.figure->font().pixelSize() == ui::localeStatisticPixels(ui::metrics::chapters::figureText),
+                "Statistics widget font and measurement disagree");
+        if (!output.isEmpty())
+            require(cell.grab().save(output + QString("/stats-%1.png").arg(ppi)), "Cannot save statistics sample");
+    }
+    ui::setDensity(ui::designPpi);
+    {
+        QWidget host;
+        host.resize(1180, 1568);
+        reader::SettingsPanel settings(&host, {});
+        settings.showButtonControls(pageButtons::paging(), {}, {});
+        const auto *invert = dynamic_cast<ui::DescribedOption *>(
+                host.findChild<QCheckBox *>("rrInvertLandscapeButtons"));
+        require(invert && invert->presentation().wrapLabel == (language == strings::Locale::Russian),
+                "Hardware inversion title wrapping did not follow the UI locale");
+    }
+    for (const auto design : { sleep::Design::Widgets, sleep::Design::Bookmark,
+                              sleep::Design::Caption, sleep::Design::Night }) {
+        sleep::Snapshot shot;
+        shot.mode = sleep::Mode::Plain;
+        shot.design = design;
+        shot.percent = 2;
+        shot.progress = strings::get("sleep.percent_read").arg(strings::percentage(qint64(2)));
+        shot.remaining = reader::sleepTimeLeft(10 * 3600000 + 19 * 60000);
+        shot.details.left = "10 ч 19 мин";
+        shot.details.title = QString::fromUtf8("Кокаиновые короли");
+        shot.details.author = QString::fromUtf8("Гульотта Г., Лин Д.");
+        shot.details.todayMilliseconds = 91 * 60000;
+        QImage backdrop(1072, 1448, QImage::Format_RGB32);
+        backdrop.fill(Qt::white);
+        const auto screen = reader::sleepDesignImage(backdrop, shot, 97, reader::SleepStatus::Sleeping);
+        require(!screen.isNull() && screen.size() == backdrop.size(), "Sleep design render failed");
+        if (!output.isEmpty())
+            require(screen.save(output + QString("/sleep-%1.png").arg(int(design))), "Cannot save sleep sample");
+    }
+    std::puts("PASS: locale ink boxes, bounded sleep fitting, percent contracts, statistics scale and design renders");
