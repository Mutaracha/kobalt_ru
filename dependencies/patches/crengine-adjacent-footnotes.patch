+    // Keep page notes next to the body using its neighboring line-box gap.
+    // The existing serialized line map makes this identical after cache reopen.
+    int footnoteBodyGap(int fallback) const {
+        int count = justificationLines.length();
+        if (count < 2) return fallback;
+        const lvPoint &before = justificationLines[count-2];
+        const lvPoint &last = justificationLines[count-1];
+        int gap = last.x - before.y;
+        return gap >= 0 && gap <= last.y-last.x ? gap : fallback;
+    }
+    int footnoteTop(int available, int fallback) const {
+        int bottom = available;
+        for (int i=0; i<footnotes.length(); ++i) bottom -= footnotes[i].height;
+        if (!height || !justificationLines.length()) return bottom;
+        int adjacent = height + footnoteBodyGap(fallback);
+        return adjacent < bottom ? adjacent : bottom;
+    }
