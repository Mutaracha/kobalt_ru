#pragma once

// The pinned engine's HTML defaults include its EPUB fragment boundaries.
// Keep publisher styles above these defaults in the cascade.
constexpr auto readerHtmlCss = R"rrcss(@READER_HTML_CSS@)rrcss";

// TENG's user-agent overrides, expressed without browser viewport or layer
// syntax. Pagination owns the viewport and the adjustable outer margins.
constexpr auto readerOverridesCss = R"rrcss(
html, DocFragment { hyphens: none; }
body { margin: 0; padding: 0; background-color: transparent; text-align: start; }
blockquote { margin-left: 40px; margin-right: 40px; }
ol, ul { padding-left: 40px; }
pre { max-width: 100%; }
table { max-width: 100%; font-size: 100%; word-break: normal; }
a[href] { color: black; text-decoration: underline; }
/* Kobo editions use this wrapper for their dotted link decoration. Do not
   inherit the anchor underline as a second line. Publisher CSS still wins. */
a[data-kobalt-kobo-link="1"] { text-decoration: none; }
se-span.kobo-link { border-bottom: 1px dotted currentColor; }
hr { border: 1px inset black; }
)rrcss";

// KOReader's reference FictionBook 2 stylesheet, taken verbatim from the
// pinned CREngine commit. It hides raw metadata tags, marks the secondary
// notes/comments bodies as non-linear and styles poems, epigraphs and tables.
constexpr auto readerFb2Css = R"rrcss(@READER_FB2_CSS@)rrcss";

// Kobalt hints on top of fb2.css. Each section of a notes/comments body is one
// footnote, so the popup engine can capture multi-paragraph notes whole
// without swallowing neighbouring sections.
constexpr auto readerFb2OverridesCss = R"rrcss(
body[name="notes"] > section,
body[name="comments"] > section {
    -cr-hint: footnote;
}
a[type="note"] {
    color: black;
}
)rrcss";
