#pragma once
// Generated by CMake from src/build_info.h.in. tools/build.py passes the
// commit of the sources, or an empty string when it is unknown.
constexpr auto kobaltCommit = "@KOBALT_COMMIT@";
// Whether the sources had uncommitted changes.
#cmakedefine01 KOBALT_COMMIT_MODIFIED
// Fork distribution identifier shown on the About page. Empty in generic
// builds, which keeps the upstream About layout unchanged.
constexpr auto kobaltForkName = "@KOBALT_FORK_NAME@";
// Configure-time UTC timestamp, rendered on the fork's About row.
constexpr auto kobaltBuildTime = "@KOBALT_BUILD_TIME@";
